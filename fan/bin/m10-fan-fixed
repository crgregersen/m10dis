#!/usr/bin/env bash

# Conservative fixed-speed fallback which does not poll NVIDIA.

set -Eeuo pipefail

/usr/local/libexec/m10-fancontrol-prepare

for channel in 1 3; do
	printf '120\n' >"/run/m10-hwmon/pwm${channel}"
	printf '1\n' >"/run/m10-hwmon/pwm${channel}_enable"
done

for channel in 1 2 3 4; do
	printf '120\n' >"/run/m10-arctic-hwmon/pwm${channel}"
done

printf 'Six M10 fan banks fixed at PWM 120; no NVIDIA polling is active\n'
