#!/usr/bin/env bash

# Put all six Tesla M10 shroud fan banks into their safe high-speed state.

set -Eeuo pipefail

/usr/local/libexec/m10-fancontrol-prepare

for channel in 1 3; do
	printf '200\n' >"/run/m10-hwmon/pwm${channel}"
	printf '1\n' >"/run/m10-hwmon/pwm${channel}_enable"
done

for channel in 1 2 3; do
	printf '255\n' >"/run/m10-arctic-hwmon/pwm${channel}"
done
printf '255\n' >/run/m10-arctic-hwmon/pwm4
