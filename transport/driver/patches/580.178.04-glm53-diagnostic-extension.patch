+static NV_STATUS glm53_serial_bar1_dma_map_requester_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+                                                            struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *requester_gpu = NULL;
+    struct pci_dev *requester_pci_dev = NULL;
+    NvU64 resource_start;
+    NvU64 resource_end;
+    NvU64 length;
+    NvU64 dma_addr;
+    NvU64 dma_end;
+    NvU64 gpu_sys;
+
+    if (!g_glm53_serial_bar1_peer_read_state.owner_active)
+        return NV_ERR_INVALID_STATE;
+    if (g_glm53_serial_bar1_peer_read_state.dma_active)
+        return NV_ERR_STATE_IN_USE;
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_serial_bar1_peer_read_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    glm53_serial_bar1_fill_outputs(params);
+    if (params->phys_query_status != NV_OK ||
+        params->matched_bar_index != 1 ||
+        !params->matched_bar_full_coverage ||
+        params->cpu_resource_start == 0 ||
+        params->cpu_resource_end < params->cpu_resource_start) {
+        return NV_ERR_NOT_SUPPORTED;
+    }
+
+    length = g_glm53_serial_bar1_peer_read_state.length;
+    resource_start = params->cpu_resource_start;
+    resource_end = resource_start + length - 1;
+    if (resource_end < resource_start ||
+        resource_end > params->owner_bar1_end ||
+        resource_start < params->owner_bar1_start ||
+        (resource_start % UVM_GLM53_PEER_READ_MIN_PAGE_SIZE) != 0 ||
+        length < UVM_PAGE_SIZE_64K ||
+        (length % UVM_GLM53_PEER_READ_MIN_PAGE_SIZE) != 0) {
+        return NV_ERR_INVALID_ADDRESS;
+    }
+
+    requester_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->requester_uuid);
+    if (!requester_gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    requester_pci_dev = requester_gpu->parent->pci_dev;
+    if (!requester_pci_dev) {
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_INVALID_DEVICE;
+    }
+    pci_dev_get(requester_pci_dev);
+
+    params->requester_dma_mask = requester_pci_dev->dev.dma_mask ?
+                                     *requester_pci_dev->dev.dma_mask :
+                                     0;
+    params->requester_coherent_dma_mask = requester_pci_dev->dev.coherent_dma_mask;
+    params->requester_dma_addressable_start = requester_gpu->parent->dma_addressable_start;
+    params->requester_dma_addressable_limit = requester_gpu->parent->dma_addressable_limit;
+    params->mapped_resource_start = resource_start;
+    params->mapped_resource_end = resource_end;
+    params->requester_dma_length = length;
+    params->dma_direction = DMA_BIDIRECTIONAL;
+    params->dma_api_path = UVM_GLM53_SERIAL_BAR1_DMA_API_DIRECT_DMA_MAP_RESOURCE;
+    params->linux_dma_map_resource_used = 1;
+    params->nv_dma_map_peer_used = 0;
+    params->dma_direction_allows_device_read = 1;
+
+    dma_addr = (NvU64)dma_map_resource(&requester_pci_dev->dev,
+                                       (phys_addr_t)resource_start,
+                                       (size_t)length,
+                                       DMA_BIDIRECTIONAL,
+                                       0);
+    params->requester_dma_address = dma_addr;
+    params->dma_mapping_error = dma_mapping_error(&requester_pci_dev->dev, (dma_addr_t)dma_addr) ? 1 : 0;
+    if (params->dma_mapping_error) {
+        params->dma_map_status = NV_ERR_OPERATING_SYSTEM;
+        pci_dev_put(requester_pci_dev);
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_OPERATING_SYSTEM;
+    }
+
+    if (length - 1 > 0xffffffffffffffffULL - dma_addr) {
+        dma_unmap_resource(&requester_pci_dev->dev, (dma_addr_t)dma_addr, (size_t)length, DMA_BIDIRECTIONAL, 0);
+        pci_dev_put(requester_pci_dev);
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_INVALID_LIMIT;
+    }
+    dma_end = dma_addr + length - 1;
+
+    if (dma_addr < requester_gpu->parent->dma_addressable_start ||
+        dma_end > requester_gpu->parent->dma_addressable_limit) {
+        params->dma_in_requester_window = 0;
+        dma_unmap_resource(&requester_pci_dev->dev, (dma_addr_t)dma_addr, (size_t)length, DMA_BIDIRECTIONAL, 0);
+        pci_dev_put(requester_pci_dev);
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_NOT_SUPPORTED;
+    }
+
+    gpu_sys = uvm_parent_gpu_dma_addr_to_gpu_addr(requester_gpu->parent, dma_addr);
+    if ((gpu_sys % UVM_GLM53_PEER_READ_MIN_PAGE_SIZE) != 0) {
+        params->destination_gpu_sys_address = gpu_sys;
+        dma_unmap_resource(&requester_pci_dev->dev, (dma_addr_t)dma_addr, (size_t)length, DMA_BIDIRECTIONAL, 0);
+        pci_dev_put(requester_pci_dev);
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_INVALID_ADDRESS;
+    }
+
+    g_glm53_serial_bar1_peer_read_state.dma_active = true;
+    g_glm53_serial_bar1_peer_read_state.route_id = g_glm53_serial_bar1_peer_read_next_route_id++;
+    if (g_glm53_serial_bar1_peer_read_next_route_id == 0)
+        g_glm53_serial_bar1_peer_read_next_route_id = 1;
+    g_glm53_serial_bar1_peer_read_state.requester_gpu = requester_gpu;
+    g_glm53_serial_bar1_peer_read_state.requester_pci_dev = requester_pci_dev;
+    g_glm53_serial_bar1_peer_read_state.mapped_resource_start = resource_start;
+    g_glm53_serial_bar1_peer_read_state.mapped_resource_end = resource_end;
+    g_glm53_serial_bar1_peer_read_state.requester_dma_address = dma_addr;
+    g_glm53_serial_bar1_peer_read_state.requester_dma_length = length;
+    g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address = gpu_sys;
+
+    params->route_id = g_glm53_serial_bar1_peer_read_state.route_id;
+    params->destination_gpu_sys_address = gpu_sys;
+    params->dma_map_status = NV_OK;
+    params->dma_active = 1;
+    params->dma_contiguous_for_length = 1;
+    params->dma_aligned_for_128k_leaf =
+        ((gpu_sys % UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE) == 0) ? 1 : 0;
+    params->dma_aligned_for_4k_leaf = 1;
+    params->dma_in_requester_window = 1;
+
+    return NV_OK;
+}
+
+static NV_STATUS glm53_serial_bar1_dma_unmap_requester_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    struct pci_dev *requester_pci_dev = g_glm53_serial_bar1_peer_read_state.requester_pci_dev;
+    uvm_gpu_t *requester_gpu = g_glm53_serial_bar1_peer_read_state.requester_gpu;
+    NvU64 dma_addr = g_glm53_serial_bar1_peer_read_state.requester_dma_address;
+    NvU64 length = g_glm53_serial_bar1_peer_read_state.requester_dma_length;
+
+    if (!g_glm53_serial_bar1_peer_read_state.dma_active)
+        return NV_ERR_INVALID_STATE;
+    if (g_glm53_serial_bar1_peer_read_state.remap_active)
+        return NV_ERR_STATE_IN_USE;
+
+    if (params->route_id != 0 &&
+        params->route_id != g_glm53_serial_bar1_peer_read_state.route_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (requester_pci_dev && length != 0) {
+        dma_unmap_resource(&requester_pci_dev->dev, (dma_addr_t)dma_addr, (size_t)length, DMA_BIDIRECTIONAL, 0);
+        params->dma_unmap_status = NV_OK;
+    }
+
+    if (requester_pci_dev)
+        pci_dev_put(requester_pci_dev);
+    if (requester_gpu)
+        uvm_gpu_release(requester_gpu);
+
+    g_glm53_serial_bar1_peer_read_state.dma_active = false;
+    g_glm53_serial_bar1_peer_read_state.requester_gpu = NULL;
+    g_glm53_serial_bar1_peer_read_state.requester_pci_dev = NULL;
+    g_glm53_serial_bar1_peer_read_state.requester_dma_address = 0;
+    g_glm53_serial_bar1_peer_read_state.requester_dma_length = 0;
+    g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address = 0;
+    g_glm53_serial_bar1_peer_read_state.mapped_resource_start = 0;
+    g_glm53_serial_bar1_peer_read_state.mapped_resource_end = 0;
+
+    return NV_OK;
+}
+
+static NV_STATUS glm53_serial_bar1_find_and_lock_gpu_va_space(
+    const UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+    uvm_va_space_t **out_va_space,
+    uvm_gpu_va_space_t **out_gpu_va_space,
+    uvm_gpu_t **out_gpu)
+{
+    uvm_va_space_t *va_space;
+    NV_STATUS status = NV_ERR_OBJECT_NOT_FOUND;
+
+    *out_va_space = NULL;
+    *out_gpu_va_space = NULL;
+    *out_gpu = NULL;
+
+    uvm_mutex_lock(&g_uvm_global.va_spaces.lock);
+
+    list_for_each_entry(va_space, &g_uvm_global.va_spaces.list, list_node) {
+        uvm_gpu_va_space_t *gpu_va_space;
+        uvm_gpu_t *gpu;
+        uvm_page_tree_t *tree;
+        uvm_gpu_phys_address_t root_phys;
+
+        if ((NvU64)(uintptr_t)va_space != params->va_space_ptr)
+            continue;
+
+        uvm_va_space_down_read(va_space);
+        uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+        gpu = uvm_va_space_get_gpu_by_uuid_with_gpu_va_space(va_space, &params->requester_uuid);
+        if (!gpu) {
+            status = NV_ERR_INVALID_DEVICE;
+            goto unlock_va_space;
+        }
+
+        gpu_va_space = uvm_gpu_va_space_get(va_space, gpu);
+        if ((NvU64)(uintptr_t)gpu_va_space != params->gpu_va_space_ptr) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (uvm_gpu_va_space_state(gpu_va_space) != UVM_GPU_VA_SPACE_STATE_ACTIVE) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        if (!gpu_va_space->did_set_page_directory) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        tree = &gpu_va_space->page_tables;
+        if (!tree->root) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        root_phys = tree->root->phys_alloc.addr;
+        if (root_phys.aperture != params->root_phys_aperture ||
+            root_phys.address != params->root_phys_address) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (params->page_size != UVM_GLM53_PEER_READ_MIN_PAGE_SIZE &&
+            params->page_size != tree->big_page_size) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        if ((params->target_va % params->page_size) != 0 ||
+            (params->target_pte_phys % UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE) != 0) {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto unlock_va_space;
+        }
+
+        if (params->target_pte_phys >= gpu->mem_info.size ||
+            UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE > gpu->mem_info.size - params->target_pte_phys) {
+            status = NV_ERR_INVALID_LIMIT;
+            goto unlock_va_space;
+        }
+
+        *out_va_space = va_space;
+        *out_gpu_va_space = gpu_va_space;
+        *out_gpu = gpu;
+        return NV_OK;
+
+unlock_va_space:
+        uvm_va_space_up_read(va_space);
+        return status;
+    }
+
+    uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+    return status;
+}
+
+static NV_STATUS glm53_serial_bar1_remap_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    uvm_va_space_t *target_va_space = NULL;
+    uvm_gpu_va_space_t *gpu_va_space = NULL;
+    uvm_gpu_t *gpu = NULL;
+    NvU64 current_pte = 0;
+    NvU64 new_pte = 0;
+    bool restore_completed = false;
+    NV_STATUS status;
+
+    if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_APPLY) {
+        bool custom_pte = params->requested_temporary_pte != 0;
+
+        if (!g_glm53_serial_bar1_peer_read_state.dma_active && !custom_pte)
+            return NV_ERR_INVALID_STATE;
+        if (g_glm53_serial_bar1_peer_read_state.remap_active)
+            return NV_ERR_STATE_IN_USE;
+        if (g_glm53_serial_bar1_peer_read_state.dma_active &&
+            params->route_id != g_glm53_serial_bar1_peer_read_state.route_id)
+            return NV_ERR_INVALID_ARGUMENT;
+        if (!g_glm53_serial_bar1_peer_read_state.dma_active && params->route_id != 0)
+            return NV_ERR_INVALID_ARGUMENT;
+    }
+    else if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_RESTORE) {
+        if (!g_glm53_serial_bar1_peer_read_state.remap_active)
+            return NV_ERR_INVALID_STATE;
+    }
+    else {
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    if (params->root_phys_aperture != UVM_APERTURE_VID)
+        return NV_ERR_NOT_SUPPORTED;
+
+    if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_RESTORE) {
+        if (params->route_id != g_glm53_serial_bar1_peer_read_state.route_id ||
+            params->target_va != g_glm53_serial_bar1_peer_read_state.target_va ||
+            params->page_size != g_glm53_serial_bar1_peer_read_state.page_size ||
+            params->target_pte_phys != g_glm53_serial_bar1_peer_read_state.target_pte_phys) {
+            return NV_ERR_OBJECT_TYPE_MISMATCH;
+        }
+    }
+
+    if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_APPLY &&
+        params->requested_temporary_pte != 0) {
+        params->destination_gpu_sys_address = params->requested_destination_gpu_sys_address;
+    }
+    else if (g_glm53_serial_bar1_peer_read_state.dma_active) {
+        params->destination_gpu_sys_address =
+            g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address;
+    }
+    else {
+        params->destination_gpu_sys_address =
+            g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address;
+    }
+
+    if ((params->destination_gpu_sys_address % params->page_size) != 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    status = glm53_serial_bar1_find_and_lock_gpu_va_space(params, &target_va_space, &gpu_va_space, &gpu);
+    if (status != NV_OK)
+        return status;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &current_pte);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_before = current_pte;
+
+    if (current_pte != params->expected_current_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_APPLY) {
+        if (params->page_size != UVM_GLM53_PEER_READ_MIN_PAGE_SIZE &&
+            !glm53_pte_is_local_vidmem(current_pte)) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        params->requester_l2_invalidate_status = uvm_mmu_l2_invalidate(gpu, UVM_APERTURE_SYS);
+        if (params->requester_l2_invalidate_status != NV_OK) {
+            status = params->requester_l2_invalidate_status;
+            goto unlock_va_space;
+        }
+
+        params->requester_phys_tlb_invalidate_status = uvm_mmu_tlb_invalidate_phys(gpu);
+        if (params->requester_phys_tlb_invalidate_status != NV_OK) {
+            status = params->requester_phys_tlb_invalidate_status;
+            goto unlock_va_space;
+        }
+
+        if (params->requested_temporary_pte != 0) {
+            new_pte = params->requested_temporary_pte;
+        }
+        else {
+            new_pte = gpu_va_space->page_tables.hal->make_pte(UVM_APERTURE_SYS,
+                                                              params->destination_gpu_sys_address,
+                                                              UVM_PROT_READ_ONLY,
+                                                              UVM_MMU_PTE_FLAGS_NONE);
+        }
+        glm53_serial_bar1_decode_pte_outputs(params, new_pte);
+        if (!glm53_serial_bar1_pte_is_sys_for_address(new_pte,
+                                                      params->destination_gpu_sys_address,
+                                                      params->requested_allow_writable != 0)) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        g_glm53_serial_bar1_peer_read_state.remap_active = true;
+        g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space = gpu_va_space;
+        uvm_gpu_va_space_retain(gpu_va_space);
+        g_glm53_serial_bar1_peer_read_state.target_va = params->target_va;
+        g_glm53_serial_bar1_peer_read_state.page_size = params->page_size;
+        g_glm53_serial_bar1_peer_read_state.target_pte_phys = params->target_pte_phys;
+        g_glm53_serial_bar1_peer_read_state.original_pte = current_pte;
+        g_glm53_serial_bar1_peer_read_state.temporary_pte = new_pte;
+        g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address = params->destination_gpu_sys_address;
+    }
+    else {
+        if (current_pte != g_glm53_serial_bar1_peer_read_state.temporary_pte) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        new_pte = g_glm53_serial_bar1_peer_read_state.original_pte;
+        glm53_serial_bar1_decode_pte_outputs(params, current_pte);
+    }
+
+    status = glm53_write_pte_and_invalidate(gpu_va_space,
+                                            params->target_va,
+                                            params->page_size,
+                                            params->target_pte_phys,
+                                            new_pte);
+    params->pte_update_status = status;
+    if (status != NV_OK) {
+        if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_APPLY) {
+            NvU64 after_failed_apply = 0;
+
+            if (glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &after_failed_apply) == NV_OK) {
+                params->pte_after = after_failed_apply;
+                if (after_failed_apply == current_pte) {
+                    uvm_gpu_va_space_release(g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space);
+                    g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space = NULL;
+                    g_glm53_serial_bar1_peer_read_state.remap_active = false;
+                }
+            }
+        }
+        goto unlock_va_space;
+    }
+
+    params->pte_written = new_pte;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &params->pte_after);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    if (params->pte_after != new_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_RESTORE) {
+        uvm_gpu_va_space_release(g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space);
+        g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space = NULL;
+        g_glm53_serial_bar1_peer_read_state.remap_active = false;
+        restore_completed = true;
+    }
+
+unlock_va_space:
+    uvm_va_space_up_read(target_va_space);
+
+    if (restore_completed) {
+        params->remap_active = 0;
+        params->saved_original_pte = g_glm53_serial_bar1_peer_read_state.original_pte;
+        params->temporary_pte = g_glm53_serial_bar1_peer_read_state.temporary_pte;
+        params->active_target_pte_phys = g_glm53_serial_bar1_peer_read_state.target_pte_phys;
+        params->active_target_va = g_glm53_serial_bar1_peer_read_state.target_va;
+    }
+
+    return status;
+}
+
+static NV_STATUS glm53_serial_bar1_release_owner_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    if (!g_glm53_serial_bar1_peer_read_state.owner_active)
+        return NV_ERR_INVALID_STATE;
+
+    if (g_glm53_serial_bar1_peer_read_state.remap_active ||
+        g_glm53_serial_bar1_peer_read_state.dma_active) {
+        return NV_ERR_STATE_IN_USE;
+    }
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_serial_bar1_peer_read_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (g_glm53_serial_bar1_peer_read_state.verify_rm_mem)
+        uvm_rm_mem_free(g_glm53_serial_bar1_peer_read_state.verify_rm_mem);
+
+    if (g_glm53_serial_bar1_peer_read_state.target_rm_mem)
+        uvm_rm_mem_free(g_glm53_serial_bar1_peer_read_state.target_rm_mem);
+
+    if (g_glm53_serial_bar1_peer_read_state.owner_gpu)
+        uvm_gpu_release(g_glm53_serial_bar1_peer_read_state.owner_gpu);
+
+    memset(&g_glm53_serial_bar1_peer_read_state, 0, sizeof(g_glm53_serial_bar1_peer_read_state));
+    params->free_completed = 1;
+    params->release_status = NV_OK;
+
+    return NV_OK;
+}
+
+NV_STATUS uvm_api_glm53_serial_bar1_peer_read(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params, struct file *filp)
+{
+    NvProcessorUuid requester_uuid = params->requester_uuid;
+    NvProcessorUuid owner_uuid = params->owner_uuid;
+    NvU32 op = params->op;
+    NvU32 epoch = params->epoch;
+    NvU64 length = params->length;
+    NvU64 gpu_alignment = params->gpu_alignment;
+    NvU64 seed = params->seed;
+    NvU64 mapping_id = params->mapping_id;
+    NvU64 route_id = params->route_id;
+    NvU64 test_word_offset = params->test_word_offset;
+    NvU32 root_phys_aperture = params->root_phys_aperture;
+    NvU64 va_space_ptr = params->va_space_ptr;
+    NvU64 gpu_va_space_ptr = params->gpu_va_space_ptr;
+    NvU64 root_phys_address = params->root_phys_address;
+    NvU64 target_va = params->target_va;
+    NvU64 page_size = params->page_size;
+    NvU64 target_pte_phys = params->target_pte_phys;
+    NvU64 expected_current_pte = params->expected_current_pte;
+    NvU64 requested_temporary_pte = params->requested_temporary_pte;
+    NvU64 requested_destination_gpu_sys_address = params->requested_destination_gpu_sys_address;
+    NvU32 requested_allow_writable = params->requested_allow_writable;
+    NV_STATUS status = NV_OK;
+
+    memset(params, 0, sizeof(*params));
+    params->requester_uuid = requester_uuid;
+    params->owner_uuid = owner_uuid;
+    params->op = op;
+    params->epoch = epoch;
+    params->length = length;
+    params->gpu_alignment = gpu_alignment;
+    params->seed = seed;
+    params->mapping_id = mapping_id;
+    params->route_id = route_id;
+    params->test_word_offset = test_word_offset;
+    params->root_phys_aperture = root_phys_aperture;
+    params->va_space_ptr = va_space_ptr;
+    params->gpu_va_space_ptr = gpu_va_space_ptr;
+    params->root_phys_address = root_phys_address;
+    params->target_va = target_va;
+    params->page_size = page_size;
+    params->target_pte_phys = target_pte_phys;
+    params->expected_current_pte = expected_current_pte;
+    params->requested_temporary_pte = requested_temporary_pte;
+    params->requested_destination_gpu_sys_address = requested_destination_gpu_sys_address;
+    params->requested_allow_writable = requested_allow_writable;
+    params->matched_bar_index = UVM_GLM53_RM_CPUMAP_PHYS_BAR_NONE;
+    params->dma_direction = DMA_BIDIRECTIONAL;
+    params->dma_api_path = UVM_GLM53_SERIAL_BAR1_DMA_API_DIRECT_DMA_MAP_RESOURCE;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_serial_bar1_peer_read_mutex);
+
+    switch (op) {
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_QUERY:
+            status = NV_OK;
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_ACQUIRE_OWNER:
+            status = glm53_serial_bar1_acquire_owner_locked(params, filp);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_PREPARE_OWNER_EPOCH:
+            status = glm53_serial_bar1_prepare_owner_epoch_locked(params);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_VERIFY_OWNER_EPOCH:
+            status = glm53_serial_bar1_verify_owner_epoch_locked(params);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_DMA_MAP_REQUESTER:
+            status = glm53_serial_bar1_dma_map_requester_locked(params, filp);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_DMA_UNMAP_REQUESTER:
+            status = glm53_serial_bar1_dma_unmap_requester_locked(params);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_APPLY:
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_REMAP_RESTORE:
+            status = glm53_serial_bar1_remap_locked(params);
+            break;
+        case UVM_GLM53_SERIAL_BAR1_PEER_READ_OP_RELEASE_OWNER:
+            status = glm53_serial_bar1_release_owner_locked(params);
+            break;
+        default:
+            status = NV_ERR_INVALID_ARGUMENT;
+            break;
+    }
+
+    glm53_serial_bar1_fill_outputs(params);
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_serial_bar1_peer_read_mutex);
+
+    return status;
+}
+
+typedef struct
+{
+    bool active;
+    NvU64 mapping_id;
+    NvProcessorUuid gpu_uuid;
+    uvm_gpu_va_space_t *gpu_va_space;
+    NvU64 va_space_ptr;
+    NvU64 gpu_va_space_ptr;
+    NvU32 root_phys_aperture;
+    NvU64 root_phys_address;
+    NvU64 target_va;
+    NvU64 page_size;
+    NvU64 target_pte_phys;
+    NvU64 original_pte;
+    NvU64 temporary_pte;
+    NvU64 destination_gpu_sys_address;
+} glm53_multi_pte_remap_state_t;
+
+static DEFINE_MUTEX(g_glm53_multi_pte_remap_mutex);
+static glm53_multi_pte_remap_state_t g_glm53_multi_pte_remap_state[UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE];
+static NvU64 g_glm53_multi_pte_remap_next_id = 1;
+
+static NvU32 glm53_multi_pte_active_count(void)
+{
+    NvU32 count = 0;
+    NvU32 i;
+
+    for (i = 0; i < UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE; ++i) {
+        if (g_glm53_multi_pte_remap_state[i].active)
+            ++count;
+    }
+
+    return count;
+}
+
+static void glm53_multi_pte_decode_pte_outputs(UVM_GLM53_MULTI_PTE_REMAP_PARAMS *params, NvU64 pte)
+{
+    params->decoded_aperture_bits = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK) >> 33);
+    params->decoded_kind = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_KIND_MASK) >> 36);
+    params->decoded_read_only = (pte & UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK) ? 1 : 0;
+    params->decoded_read_disable = (pte & UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK) ? 1 : 0;
+    params->decoded_write_disable = (pte & UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK) ? 1 : 0;
+    params->decoded_volatile = (pte & UVM_GLM53_MAXWELL_PTE_VOL_MASK) ? 1 : 0;
+}
+
+static void glm53_multi_pte_fill_entry_outputs(UVM_GLM53_MULTI_PTE_REMAP_PARAMS *params, NvU32 slot)
+{
+    glm53_multi_pte_remap_state_t *entry;
+
+    if (slot >= UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE)
+        return;
+
+    entry = &g_glm53_multi_pte_remap_state[slot];
+    if (!entry->active)
+        return;
+
+    params->slot = slot;
+    params->mapping_id = entry->mapping_id;
+    params->root_phys_aperture = entry->root_phys_aperture;
+    params->va_space_ptr = entry->va_space_ptr;
+    params->gpu_va_space_ptr = entry->gpu_va_space_ptr;
+    params->root_phys_address = entry->root_phys_address;
+    params->active_target_va = entry->target_va;
+    params->active_target_pte_phys = entry->target_pte_phys;
+    params->target_va = entry->target_va;
+    params->target_pte_phys = entry->target_pte_phys;
+    params->page_size = entry->page_size;
+    params->saved_original_pte = entry->original_pte;
+    params->temporary_pte = entry->temporary_pte;
+    params->active_destination_gpu_sys_address = entry->destination_gpu_sys_address;
+    params->requested_destination_gpu_sys_address = entry->destination_gpu_sys_address;
+    glm53_multi_pte_decode_pte_outputs(params, entry->temporary_pte);
+    if (entry->gpu_va_space)
+        params->retained_gpu_va_space_state = uvm_gpu_va_space_state(entry->gpu_va_space);
+}
+
+static NV_STATUS glm53_multi_pte_find_and_lock_gpu_va_space(
+    const UVM_GLM53_MULTI_PTE_REMAP_PARAMS *params,
+    uvm_va_space_t **out_va_space,
+    uvm_gpu_va_space_t **out_gpu_va_space,
+    uvm_gpu_t **out_gpu)
+{
+    uvm_va_space_t *va_space;
+    NV_STATUS status = NV_ERR_OBJECT_NOT_FOUND;
+
+    *out_va_space = NULL;
+    *out_gpu_va_space = NULL;
+    *out_gpu = NULL;
+
+    uvm_mutex_lock(&g_uvm_global.va_spaces.lock);
+
+    list_for_each_entry(va_space, &g_uvm_global.va_spaces.list, list_node) {
+        uvm_gpu_va_space_t *gpu_va_space;
+        uvm_gpu_t *gpu;
+        uvm_page_tree_t *tree;
+        uvm_gpu_phys_address_t root_phys;
+
+        if ((NvU64)(uintptr_t)va_space != params->va_space_ptr)
+            continue;
+
+        uvm_va_space_down_read(va_space);
+        uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+        gpu = uvm_va_space_get_gpu_by_uuid_with_gpu_va_space(va_space, &params->gpu_uuid);
+        if (!gpu) {
+            status = NV_ERR_INVALID_DEVICE;
+            goto unlock_va_space;
+        }
+
+        gpu_va_space = uvm_gpu_va_space_get(va_space, gpu);
+        if ((NvU64)(uintptr_t)gpu_va_space != params->gpu_va_space_ptr) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (uvm_gpu_va_space_state(gpu_va_space) != UVM_GPU_VA_SPACE_STATE_ACTIVE) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        if (!gpu_va_space->did_set_page_directory) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        tree = &gpu_va_space->page_tables;
+        if (!tree->root) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        root_phys = tree->root->phys_alloc.addr;
+        if (root_phys.aperture != params->root_phys_aperture ||
+            root_phys.address != params->root_phys_address) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (params->page_size != UVM_PAGE_SIZE_4K &&
+            params->page_size != tree->big_page_size) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        if ((params->target_va % params->page_size) != 0 ||
+            (params->target_pte_phys % UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE) != 0) {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto unlock_va_space;
+        }
+
+        if (params->target_pte_phys >= gpu->mem_info.size ||
+            UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE > gpu->mem_info.size - params->target_pte_phys) {
+            status = NV_ERR_INVALID_LIMIT;
+            goto unlock_va_space;
+        }
+
+        *out_va_space = va_space;
+        *out_gpu_va_space = gpu_va_space;
+        *out_gpu = gpu;
+        return NV_OK;
+
+unlock_va_space:
+        uvm_va_space_up_read(va_space);
+        return status;
+    }
+
+    uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+    return status;
+}
+
+static NV_STATUS glm53_multi_pte_apply_locked(UVM_GLM53_MULTI_PTE_REMAP_PARAMS *params)
+{
+    uvm_va_space_t *target_va_space = NULL;
+    uvm_gpu_va_space_t *gpu_va_space = NULL;
+    uvm_gpu_t *gpu = NULL;
+    NvU64 current_pte = 0;
+    NvU64 new_pte = params->requested_temporary_pte;
+    NvU32 free_slot = UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE;
+    NvU32 i;
+    NV_STATUS status;
+
+    if (new_pte == 0)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (params->root_phys_aperture != UVM_APERTURE_VID)
+        return NV_ERR_NOT_SUPPORTED;
+
+    if (params->page_size == 0 ||
+        (params->requested_destination_gpu_sys_address % params->page_size) != 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    for (i = 0; i < UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE; ++i) {
+        if (!g_glm53_multi_pte_remap_state[i].active) {
+            if (free_slot == UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE)
+                free_slot = i;
+            continue;
+        }
+
+        if ((g_glm53_multi_pte_remap_state[i].target_pte_phys == params->target_pte_phys &&
+             memcmp(&g_glm53_multi_pte_remap_state[i].gpu_uuid,
+                    &params->gpu_uuid,
+                    sizeof(params->gpu_uuid)) == 0) ||
+            (params->mapping_id != 0 &&
+             g_glm53_multi_pte_remap_state[i].mapping_id == params->mapping_id)) {
+            params->duplicate_or_stale = 1;
+            return NV_ERR_STATE_IN_USE;
+        }
+    }
+
+    if (free_slot == UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+
+    status = glm53_multi_pte_find_and_lock_gpu_va_space(params, &target_va_space, &gpu_va_space, &gpu);
+    params->lookup_status = status;
+    if (status != NV_OK)
+        return status;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &current_pte);
+    params->read_status = status;
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_before = current_pte;
+    if (current_pte != params->expected_current_pte) {
+        params->duplicate_or_stale = 1;
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (!glm53_serial_bar1_pte_is_sys_for_address(new_pte,
+                                                  params->requested_destination_gpu_sys_address,
+                                                  params->requested_allow_writable != 0)) {
+        params->pte_validation_status = NV_ERR_NOT_SUPPORTED;
+        status = params->pte_validation_status;
+        goto unlock_va_space;
+    }
+    params->pte_validation_status = NV_OK;
+
+    params->requester_l2_invalidate_status = uvm_mmu_l2_invalidate(gpu, UVM_APERTURE_SYS);
+    if (params->requester_l2_invalidate_status != NV_OK) {
+        status = params->requester_l2_invalidate_status;
+        goto unlock_va_space;
+    }
+
+    params->requester_phys_tlb_invalidate_status = uvm_mmu_tlb_invalidate_phys(gpu);
+    if (params->requester_phys_tlb_invalidate_status != NV_OK) {
+        status = params->requester_phys_tlb_invalidate_status;
+        goto unlock_va_space;
+    }
+
+    params->pte_update_attempted = 1;
+    status = glm53_write_pte_and_invalidate(gpu_va_space,
+                                            params->target_va,
+                                            params->page_size,
+                                            params->target_pte_phys,
+                                            new_pte);
+    params->pte_update_status = status;
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_written = new_pte;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &params->pte_after);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    if (params->pte_after != new_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    g_glm53_multi_pte_remap_state[free_slot].active = true;
+    g_glm53_multi_pte_remap_state[free_slot].mapping_id = g_glm53_multi_pte_remap_next_id++;
+    if (g_glm53_multi_pte_remap_next_id == 0)
+        g_glm53_multi_pte_remap_next_id = 1;
+    uvm_uuid_copy(&g_glm53_multi_pte_remap_state[free_slot].gpu_uuid, &params->gpu_uuid);
+    g_glm53_multi_pte_remap_state[free_slot].gpu_va_space = gpu_va_space;
+    uvm_gpu_va_space_retain(gpu_va_space);
+    g_glm53_multi_pte_remap_state[free_slot].va_space_ptr = params->va_space_ptr;
+    g_glm53_multi_pte_remap_state[free_slot].gpu_va_space_ptr = params->gpu_va_space_ptr;
+    g_glm53_multi_pte_remap_state[free_slot].root_phys_aperture = params->root_phys_aperture;
+    g_glm53_multi_pte_remap_state[free_slot].root_phys_address = params->root_phys_address;
+    g_glm53_multi_pte_remap_state[free_slot].target_va = params->target_va;
+    g_glm53_multi_pte_remap_state[free_slot].page_size = params->page_size;
+    g_glm53_multi_pte_remap_state[free_slot].target_pte_phys = params->target_pte_phys;
+    g_glm53_multi_pte_remap_state[free_slot].original_pte = current_pte;
+    g_glm53_multi_pte_remap_state[free_slot].temporary_pte = new_pte;
+    g_glm53_multi_pte_remap_state[free_slot].destination_gpu_sys_address =
+        params->requested_destination_gpu_sys_address;
+
+    params->mapping_id = g_glm53_multi_pte_remap_state[free_slot].mapping_id;
+    glm53_multi_pte_fill_entry_outputs(params, free_slot);
+
+unlock_va_space:
+    uvm_va_space_up_read(target_va_space);
+
+    return status;
+}
+
+static NV_STATUS glm53_multi_pte_restore_locked(UVM_GLM53_MULTI_PTE_REMAP_PARAMS *params)
+{
+    uvm_va_space_t *target_va_space = NULL;
+    uvm_gpu_va_space_t *gpu_va_space = NULL;
+    uvm_gpu_t *gpu = NULL;
+    glm53_multi_pte_remap_state_t saved;
+    NvU64 current_pte = 0;
+    NvU64 restored_pte = 0;
+    NvU32 slot = UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE;
+    NvU32 i;
+    NV_STATUS status;
+
+    memset(&saved, 0, sizeof(saved));
+
+    for (i = 0; i < UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE; ++i) {
+        if (g_glm53_multi_pte_remap_state[i].active &&
+            g_glm53_multi_pte_remap_state[i].mapping_id == params->mapping_id) {
+            slot = i;
+            saved = g_glm53_multi_pte_remap_state[i];
+            break;
+        }
+    }
+
+    if (slot == UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE)
+        return NV_ERR_OBJECT_NOT_FOUND;
+
+    if ((params->target_pte_phys != 0 && params->target_pte_phys != saved.target_pte_phys) ||
+        (params->target_va != 0 && params->target_va != saved.target_va)) {
+        params->duplicate_or_stale = 1;
+        return NV_ERR_OBJECT_TYPE_MISMATCH;
+    }
+
+    params->gpu_uuid = saved.gpu_uuid;
+    params->root_phys_aperture = saved.root_phys_aperture;
+    params->va_space_ptr = saved.va_space_ptr;
+    params->gpu_va_space_ptr = saved.gpu_va_space_ptr;
+    params->root_phys_address = saved.root_phys_address;
+    params->target_va = saved.target_va;
+    params->page_size = saved.page_size;
+    params->target_pte_phys = saved.target_pte_phys;
+    params->expected_current_pte = saved.temporary_pte;
+    params->requested_temporary_pte = saved.original_pte;
+    params->requested_destination_gpu_sys_address = saved.destination_gpu_sys_address;
+
+    status = glm53_multi_pte_find_and_lock_gpu_va_space(params, &target_va_space, &gpu_va_space, &gpu);
+    params->lookup_status = status;
+    if (status != NV_OK)
+        return status;
+
+    if (gpu_va_space != saved.gpu_va_space) {
+        status = NV_ERR_OBJECT_TYPE_MISMATCH;
+        goto unlock_va_space;
+    }
+
+    status = glm53_read_phys_vidmem_u64(gpu, saved.target_pte_phys, &current_pte);
+    params->read_status = status;
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_before = current_pte;
+    if (current_pte != saved.temporary_pte) {
+        params->duplicate_or_stale = 1;
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    params->requester_l2_invalidate_status = uvm_mmu_l2_invalidate(gpu, UVM_APERTURE_SYS);
+    if (params->requester_l2_invalidate_status != NV_OK) {
+        status = params->requester_l2_invalidate_status;
+        goto unlock_va_space;
+    }
+
+    params->requester_phys_tlb_invalidate_status = uvm_mmu_tlb_invalidate_phys(gpu);
+    if (params->requester_phys_tlb_invalidate_status != NV_OK) {
+        status = params->requester_phys_tlb_invalidate_status;
+        goto unlock_va_space;
+    }
+
+    restored_pte = saved.original_pte;
+    params->pte_update_attempted = 1;
+    status = glm53_write_pte_and_invalidate(gpu_va_space,
+                                            saved.target_va,
+                                            saved.page_size,
+                                            saved.target_pte_phys,
+                                            restored_pte);
+    params->pte_update_status = status;
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_written = restored_pte;
+
+    status = glm53_read_phys_vidmem_u64(gpu, saved.target_pte_phys, &params->pte_after);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    if (params->pte_after != restored_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    params->pte_restored = 1;
+    params->slot = slot;
+    params->mapping_id = saved.mapping_id;
+    params->saved_original_pte = saved.original_pte;
+    params->temporary_pte = saved.temporary_pte;
+    params->active_target_va = saved.target_va;
+    params->active_target_pte_phys = saved.target_pte_phys;
+    params->active_destination_gpu_sys_address = saved.destination_gpu_sys_address;
+    glm53_multi_pte_decode_pte_outputs(params, saved.temporary_pte);
+
+    uvm_gpu_va_space_release(saved.gpu_va_space);
+    memset(&g_glm53_multi_pte_remap_state[slot], 0, sizeof(g_glm53_multi_pte_remap_state[slot]));
+
+unlock_va_space:
+    uvm_va_space_up_read(target_va_space);
+
+    return status;
+}
