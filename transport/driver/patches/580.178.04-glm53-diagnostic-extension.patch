+static NvU32 glm53_pattern_word(NvU64 seed, NvU32 pass, NvU64 word_index)
+{
+    NvU64 x = seed ^ (((NvU64)pass) << 48) ^ word_index;
+
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+
+    return (NvU32)x ^ (pass * 0x9e3779b9U);
+}
+
+static void glm53_fill_pattern(void *dst, NvU64 length, NvU64 seed, NvU32 pass)
+{
+    NvU32 *words = (NvU32 *)dst;
+    NvU64 i;
+
+    UVM_ASSERT((length % sizeof(*words)) == 0);
+
+    for (i = 0; i < length / sizeof(*words); ++i)
+        words[i] = glm53_pattern_word(seed, pass, i);
+}
+
+static NvU32 glm53_count_mismatches(void *ptr, NvU64 length, NvU64 seed, NvU32 pass)
+{
+    NvU32 *words = (NvU32 *)ptr;
+    NvU32 mismatches = 0;
+    NvU64 i;
+
+    UVM_ASSERT((length % sizeof(*words)) == 0);
+
+    for (i = 0; i < length / sizeof(*words); ++i) {
+        if (words[i] != glm53_pattern_word(seed, pass, i))
+            ++mismatches;
+    }
+
+    return mismatches;
+}
