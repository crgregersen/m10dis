+static DEFINE_MUTEX(g_glm53_serial_bar1_peer_read_mutex);
+static glm53_serial_bar1_peer_read_state_t g_glm53_serial_bar1_peer_read_state;
+static NvU64 g_glm53_serial_bar1_peer_read_next_mapping_id = 1;
+static NvU64 g_glm53_serial_bar1_peer_read_next_route_id = 1;
+
+static void glm53_serial_bar1_fill_gpu_outputs(uvm_gpu_t *gpu,
+                                               UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    struct pci_dev *pci_dev;
+
+    if (!gpu || !gpu->parent)
+        return;
+
+    params->owner_static_bar1_start = gpu->parent->static_bar1_start;
+    params->owner_static_bar1_size = gpu->parent->static_bar1_size;
+    params->fb_size = gpu->mem_info.size;
+    params->fb_max_allocatable_address = gpu->mem_info.max_allocatable_address;
+
+    pci_dev = gpu->parent->pci_dev;
+    if (!pci_dev)
+        return;
+
+    params->owner_bar0_start = pci_resource_start(pci_dev, 0);
+    params->owner_bar0_end = pci_resource_end(pci_dev, 0);
+    params->owner_bar1_start = pci_resource_start(pci_dev, 1);
+    params->owner_bar1_end = pci_resource_end(pci_dev, 1);
+    params->owner_bar3_start = pci_resource_start(pci_dev, 3);
+    params->owner_bar3_end = pci_resource_end(pci_dev, 3);
+
+    params->owner_bar0_bus_start = pci_bus_address(pci_dev, 0);
+    params->owner_bar1_bus_start = pci_bus_address(pci_dev, 1);
+    params->owner_bar3_bus_start = pci_bus_address(pci_dev, 3);
+
+    if (pci_resource_len(pci_dev, 0) != 0 &&
+        params->owner_bar0_bus_start <= 0xffffffffffffffffULL - (NvU64)pci_resource_len(pci_dev, 0) + 1)
+        params->owner_bar0_bus_end = params->owner_bar0_bus_start + (NvU64)pci_resource_len(pci_dev, 0) - 1;
+    if (pci_resource_len(pci_dev, 1) != 0 &&
+        params->owner_bar1_bus_start <= 0xffffffffffffffffULL - (NvU64)pci_resource_len(pci_dev, 1) + 1)
+        params->owner_bar1_bus_end = params->owner_bar1_bus_start + (NvU64)pci_resource_len(pci_dev, 1) - 1;
+    if (pci_resource_len(pci_dev, 3) != 0 &&
+        params->owner_bar3_bus_start <= 0xffffffffffffffffULL - (NvU64)pci_resource_len(pci_dev, 3) + 1)
+        params->owner_bar3_bus_end = params->owner_bar3_bus_start + (NvU64)pci_resource_len(pci_dev, 3) - 1;
+}
+
+static void glm53_serial_bar1_match_bar(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    NvU64 bar_starts[3] = { params->owner_bar0_start, params->owner_bar1_start, params->owner_bar3_start };
+    NvU64 bar_ends[3] = { params->owner_bar0_end, params->owner_bar1_end, params->owner_bar3_end };
+    NvU64 bar_bus_starts[3] = { params->owner_bar0_bus_start, params->owner_bar1_bus_start, params->owner_bar3_bus_start };
+    NvU64 bar_bus_ends[3] = { params->owner_bar0_bus_end, params->owner_bar1_bus_end, params->owner_bar3_bus_end };
+    NvU32 bar_indices[3] = { 0, 1, 3 };
+    NvU32 i;
+
+    params->matched_bar_index = UVM_GLM53_RM_CPUMAP_PHYS_BAR_NONE;
+    params->matched_bar_full_coverage = 0;
+
+    if (params->cpu_resource_end < params->cpu_resource_start)
+        return;
+
+    for (i = 0; i < 3; ++i) {
+        if (bar_starts[i] == 0 || bar_ends[i] < bar_starts[i])
+            continue;
+
+        if (params->cpu_resource_start >= bar_starts[i] && params->cpu_resource_end <= bar_ends[i]) {
+            params->matched_bar_index = bar_indices[i];
+            params->matched_bar_start = bar_starts[i];
+            params->matched_bar_end = bar_ends[i];
+            params->allocation_bar_offset = params->cpu_resource_start - bar_starts[i];
+            params->matched_bar_full_coverage = 1;
+            params->allocation_bar_bus_offset = params->allocation_bar_offset;
+            if (bar_bus_starts[i] != 0 &&
+                bar_bus_ends[i] >= bar_bus_starts[i] &&
+                params->allocation_bar_offset <= bar_bus_ends[i] - bar_bus_starts[i] &&
+                params->cpu_resource_end - params->cpu_resource_start <=
+                    bar_bus_ends[i] - (bar_bus_starts[i] + params->allocation_bar_offset)) {
+                params->allocation_bar_bus_start = bar_bus_starts[i] + params->allocation_bar_offset;
+                params->allocation_bar_bus_end =
+                    params->allocation_bar_bus_start + (params->cpu_resource_end - params->cpu_resource_start);
+                params->allocation_bar_bus_valid = 1;
+                params->allocation_bar_resource_equals_bus =
+                    (params->allocation_bar_bus_start == params->cpu_resource_start &&
+                     params->allocation_bar_bus_end == params->cpu_resource_end) ? 1 : 0;
+            }
+            return;
+        }
+    }
+}
+
+static NV_STATUS glm53_serial_bar1_resolve_cpu_mapping(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+                                                       uvm_rm_mem_t *rm_mem)
+{
+    NvU64 addr;
+    NvU64 length;
+    NvU64 start_page;
+    NvU64 end_addr;
+    NvU64 page_count;
+    NvU64 page_offset;
+    NvU64 phys;
+    NvU64 prev_page_resource = 0;
+    NvU64 i;
+    NV_STATUS status;
+
+    if (!rm_mem || !uvm_rm_mem_mapped_on_cpu(rm_mem))
+        return NV_ERR_INVALID_STATE;
+
+    addr = (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(rm_mem);
+    length = params->active_length;
+    if (length == 0)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (length - 1 > 0xffffffffffffffffULL - addr)
+        return NV_ERR_INVALID_LIMIT;
+
+    page_offset = addr & (UVM_PAGE_SIZE_4K - 1);
+    start_page = addr & ~(NvU64)(UVM_PAGE_SIZE_4K - 1);
+    end_addr = addr + length - 1;
+    page_count = ((end_addr & ~(NvU64)(UVM_PAGE_SIZE_4K - 1)) - start_page) / UVM_PAGE_SIZE_4K + 1;
+
+    if (page_count == 0 || page_count > 0xffffffffULL)
+        return NV_ERR_INVALID_LIMIT;
+
+    params->cpu_va_class = is_vmalloc_addr((void *)(uintptr_t)addr) ?
+                               UVM_GLM53_RM_CPUMAP_PHYS_VA_CLASS_VMALLOC :
+                               UVM_GLM53_RM_CPUMAP_PHYS_VA_CLASS_UNKNOWN;
+    params->cpu_page_offset = page_offset;
+    params->cpu_page_count = (NvU32)page_count;
+    params->cpu_phys_contiguous = 1;
+    params->cpu_phys_segments = 1;
+
+    for (i = 0; i < page_count; ++i) {
+        status = glm53_rm_cpumap_phys_kernel_va_to_phys(start_page + i * UVM_PAGE_SIZE_4K, &phys);
+        if (status != NV_OK)
+            return status;
+
+        if (i == 0) {
+            params->cpu_page0_resource = phys;
+            params->cpu_resource_start = phys + page_offset;
+        }
+        else if (i == 1) {
+            params->cpu_page1_resource = phys;
+        }
+
+        if (i == page_count - 1) {
+            params->cpu_last_page_resource = phys;
+            params->cpu_resource_end = phys + (end_addr & (UVM_PAGE_SIZE_4K - 1));
+        }
+
+        if (i != 0 && phys != prev_page_resource + UVM_PAGE_SIZE_4K) {
+            params->cpu_phys_contiguous = 0;
+            ++params->cpu_phys_segments;
+        }
+
+        prev_page_resource = phys;
+    }
+
+    glm53_serial_bar1_match_bar(params);
+
+    return NV_OK;
+}
+
+static void glm53_serial_bar1_decode_pte_outputs(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params, NvU64 pte)
+{
+    params->decoded_aperture_bits = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK) >> 33);
+    params->decoded_kind = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_KIND_MASK) >> 36);
+    params->decoded_read_only = (pte & UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK) ? 1 : 0;
+    params->decoded_read_disable = (pte & UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK) ? 1 : 0;
+    params->decoded_write_disable = (pte & UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK) ? 1 : 0;
+    params->decoded_volatile = (pte & UVM_GLM53_MAXWELL_PTE_VOL_MASK) ? 1 : 0;
+    params->decoded_sys_address = (pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK) << 8;
+}
+
+static bool glm53_serial_bar1_pte_is_sys_for_address(NvU64 pte,
+                                                     NvU64 expected_address,
+                                                     bool allow_writable)
+{
+    NvU64 aperture = pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK;
+    NvU64 expected_field =
+        ((expected_address >> 12) << 4) & UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK;
+
+    return (pte & UVM_GLM53_MAXWELL_PTE_VALID_MASK) &&
+           (aperture == (2ULL << 33) || aperture == (3ULL << 33)) &&
+           ((pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK) == expected_field) &&
+           !(pte & UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK) &&
+           (allow_writable ||
+            ((pte & UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK) &&
+             (pte & UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK)));
+}
+
+static void glm53_serial_bar1_fill_outputs(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    if (g_glm53_serial_bar1_peer_read_state.owner_active &&
+        g_glm53_serial_bar1_peer_read_state.owner_gpu &&
+        g_glm53_serial_bar1_peer_read_state.target_rm_mem) {
+        params->owner_active = 1;
+        params->mapping_id = g_glm53_serial_bar1_peer_read_state.mapping_id;
+        params->active_length = g_glm53_serial_bar1_peer_read_state.length;
+        params->length = g_glm53_serial_bar1_peer_read_state.length;
+        params->gpu_alignment = g_glm53_serial_bar1_peer_read_state.gpu_alignment;
+        params->seed = g_glm53_serial_bar1_peer_read_state.seed;
+        params->target_gpu_va =
+            uvm_rm_mem_get_gpu_uvm_va(g_glm53_serial_bar1_peer_read_state.target_rm_mem,
+                                      g_glm53_serial_bar1_peer_read_state.owner_gpu);
+        params->target_cpu_va_kernel =
+            (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(g_glm53_serial_bar1_peer_read_state.target_rm_mem);
+
+        if (g_glm53_serial_bar1_peer_read_state.verify_rm_mem) {
+            params->verify_gpu_va =
+                uvm_rm_mem_get_gpu_uvm_va(g_glm53_serial_bar1_peer_read_state.verify_rm_mem,
+                                          g_glm53_serial_bar1_peer_read_state.owner_gpu);
+            params->verify_cpu_va_kernel =
+                (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(g_glm53_serial_bar1_peer_read_state.verify_rm_mem);
+        }
+
+        glm53_serial_bar1_fill_gpu_outputs(g_glm53_serial_bar1_peer_read_state.owner_gpu, params);
+        params->phys_query_status =
+            glm53_serial_bar1_resolve_cpu_mapping(params,
+                                                  g_glm53_serial_bar1_peer_read_state.target_rm_mem);
+    }
+
+    if (g_glm53_serial_bar1_peer_read_state.dma_active) {
+        struct pci_dev *requester_pci_dev = g_glm53_serial_bar1_peer_read_state.requester_pci_dev;
+
+        params->dma_active = 1;
+        params->route_id = g_glm53_serial_bar1_peer_read_state.route_id;
+        params->mapped_resource_start = g_glm53_serial_bar1_peer_read_state.mapped_resource_start;
+        params->mapped_resource_end = g_glm53_serial_bar1_peer_read_state.mapped_resource_end;
+        params->requester_dma_address = g_glm53_serial_bar1_peer_read_state.requester_dma_address;
+        params->requester_dma_length = g_glm53_serial_bar1_peer_read_state.requester_dma_length;
+        params->destination_gpu_sys_address = g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address;
+        params->dma_direction = DMA_BIDIRECTIONAL;
+        params->dma_api_path = UVM_GLM53_SERIAL_BAR1_DMA_API_DIRECT_DMA_MAP_RESOURCE;
+        params->linux_dma_map_resource_used = 1;
+        params->nv_dma_map_peer_used = 0;
+        params->dma_direction_allows_device_read = 1;
+        params->dma_contiguous_for_length = 1;
+        if (g_glm53_serial_bar1_peer_read_state.requester_gpu &&
+            g_glm53_serial_bar1_peer_read_state.requester_gpu->parent) {
+            params->requester_dma_addressable_start =
+                g_glm53_serial_bar1_peer_read_state.requester_gpu->parent->dma_addressable_start;
+            params->requester_dma_addressable_limit =
+                g_glm53_serial_bar1_peer_read_state.requester_gpu->parent->dma_addressable_limit;
+        }
+        if (requester_pci_dev) {
+            params->requester_dma_mask = requester_pci_dev->dev.dma_mask ?
+                                             *requester_pci_dev->dev.dma_mask :
+                                             0;
+            params->requester_coherent_dma_mask = requester_pci_dev->dev.coherent_dma_mask;
+        }
+        if ((params->destination_gpu_sys_address % UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE) == 0)
+            params->dma_aligned_for_128k_leaf = 1;
+        if ((params->destination_gpu_sys_address % UVM_GLM53_PEER_READ_MIN_PAGE_SIZE) == 0)
+            params->dma_aligned_for_4k_leaf = 1;
+        if (params->requester_dma_address >= params->requester_dma_addressable_start &&
+            params->requester_dma_address <= params->requester_dma_addressable_limit &&
+            params->requester_dma_length != 0 &&
+            params->requester_dma_length - 1 <=
+                params->requester_dma_addressable_limit - params->requester_dma_address) {
+            params->dma_in_requester_window = 1;
+        }
+    }
+
+    if (g_glm53_serial_bar1_peer_read_state.remap_active) {
+        params->remap_active = 1;
+        params->route_id = g_glm53_serial_bar1_peer_read_state.route_id;
+        params->saved_original_pte = g_glm53_serial_bar1_peer_read_state.original_pte;
+        params->temporary_pte = g_glm53_serial_bar1_peer_read_state.temporary_pte;
+        params->active_target_pte_phys = g_glm53_serial_bar1_peer_read_state.target_pte_phys;
+        params->active_target_va = g_glm53_serial_bar1_peer_read_state.target_va;
+        params->destination_gpu_sys_address =
+            g_glm53_serial_bar1_peer_read_state.destination_gpu_sys_address;
+        glm53_serial_bar1_decode_pte_outputs(params, g_glm53_serial_bar1_peer_read_state.temporary_pte);
+        if (g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space) {
+            params->retained_gpu_va_space_state =
+                uvm_gpu_va_space_state(g_glm53_serial_bar1_peer_read_state.remap_gpu_va_space);
+        }
+    }
+}
