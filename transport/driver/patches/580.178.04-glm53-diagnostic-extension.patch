+static NvU32 glm53_serial_bar1_owner_pattern(NvU64 seed, NvU32 epoch, NvU64 word_index)
+{
+    NvU32 base = glm53_rm_cpumap_phys_pattern(seed, 1, 1, word_index);
+
+    if (epoch == 2)
+        return ~base;
+
+    return glm53_rm_cpumap_phys_pattern(seed, epoch, 1, word_index);
+}
+
+static void glm53_serial_bar1_fill_owner_words(void *ptr, NvU64 length, NvU64 seed, NvU32 epoch)
+{
+    volatile NvU32 *words = (volatile NvU32 *)ptr;
+    NvU64 i;
+
+    UVM_ASSERT((length % sizeof(*words)) == 0);
+
+    for (i = 0; i < length / sizeof(*words); ++i)
+        words[i] = glm53_serial_bar1_owner_pattern(seed, epoch, i);
+
+    mb();
+}
+
+static void glm53_serial_bar1_compare_owner_words(void *ptr,
+                                                  NvU64 length,
+                                                  NvU64 seed,
+                                                  NvU32 epoch,
+                                                  UVM_GLM53_RM_CPUMAP_PHYS_COMPARE_RESULT *result)
+{
+    volatile NvU32 *words = (volatile NvU32 *)ptr;
+    NvU64 i;
+    NvU32 expected;
+    NvU32 observed;
+    NvU32 word_count;
+
+    memset(result, 0, sizeof(*result));
+
+    if (length == 0 || (length % sizeof(*words)) != 0 || length / sizeof(*words) > 0xffffffffULL) {
+        result->status = NV_ERR_INVALID_LIMIT;
+        return;
+    }
+
+    word_count = (NvU32)(length / sizeof(*words));
+    result->words_checked = word_count;
+    result->first_mismatch_index = 0xffffffffU;
+
+    for (i = 0; i < word_count; ++i) {
+        expected = glm53_serial_bar1_owner_pattern(seed, epoch, i);
+        observed = words[i];
+
+        if (i == 0) {
+            result->first_expected = expected;
+            result->first_observed = observed;
+        }
+
+        if (i == word_count - 1) {
+            result->last_expected = expected;
+            result->last_observed = observed;
+        }
+
+        if (observed != expected) {
+            if (result->mismatches == 0)
+                result->first_mismatch_index = (NvU32)i;
+            ++result->mismatches;
+        }
+    }
+
+    result->status = result->mismatches == 0 ? NV_OK : NV_ERR_INVALID_STATE;
+}
+
+static NV_STATUS glm53_serial_bar1_acquire_owner_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+                                                        struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *owner_gpu = NULL;
+    uvm_rm_mem_t *target_rm_mem = NULL;
+    uvm_rm_mem_t *verify_rm_mem = NULL;
+    NvU64 length = params->length;
+    NvU64 gpu_alignment = params->gpu_alignment;
+    NvU64 seed = params->seed;
+    NV_STATUS status;
+
+    if (g_glm53_serial_bar1_peer_read_state.owner_active)
+        return NV_ERR_STATE_IN_USE;
+
+    if (length == 0)
+        length = UVM_PAGE_SIZE_64K;
+    if (gpu_alignment == 0)
+        gpu_alignment = UVM_PAGE_SIZE_64K;
+    if (seed == 0)
+        seed = UVM_GLM53_SELF_TEST_DEFAULT_SEED ^ 0x5345524241523152ULL;
+
+    if (length < UVM_PAGE_SIZE_64K ||
+        length > UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE ||
+        gpu_alignment < UVM_GLM53_PEER_READ_MIN_PAGE_SIZE ||
+        (length % UVM_PAGE_SIZE_4K) != 0 ||
+        (gpu_alignment % UVM_PAGE_SIZE_4K) != 0 ||
+        (length % sizeof(NvU32)) != 0) {
+        return NV_ERR_INVALID_LIMIT;
+    }
+
+    owner_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->owner_uuid);
+    if (!owner_gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    glm53_serial_bar1_fill_gpu_outputs(owner_gpu, params);
+
+    status = uvm_rm_mem_alloc(owner_gpu, UVM_RM_MEM_TYPE_GPU, length, gpu_alignment, &target_rm_mem);
+    params->acquire_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_map_cpu(target_rm_mem);
+    params->target_map_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_alloc(owner_gpu, UVM_RM_MEM_TYPE_SYS, length, gpu_alignment, &verify_rm_mem);
+    params->verify_alloc_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_map_cpu(verify_rm_mem);
+    params->verify_map_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    memset(&g_glm53_serial_bar1_peer_read_state, 0, sizeof(g_glm53_serial_bar1_peer_read_state));
+    g_glm53_serial_bar1_peer_read_state.owner_active = true;
+    g_glm53_serial_bar1_peer_read_state.mapping_id = g_glm53_serial_bar1_peer_read_next_mapping_id++;
+    if (g_glm53_serial_bar1_peer_read_next_mapping_id == 0)
+        g_glm53_serial_bar1_peer_read_next_mapping_id = 1;
+    uvm_uuid_copy(&g_glm53_serial_bar1_peer_read_state.owner_uuid, &params->owner_uuid);
+    uvm_uuid_copy(&g_glm53_serial_bar1_peer_read_state.requester_uuid, &params->requester_uuid);
+    g_glm53_serial_bar1_peer_read_state.owner_gpu = owner_gpu;
+    g_glm53_serial_bar1_peer_read_state.target_rm_mem = target_rm_mem;
+    g_glm53_serial_bar1_peer_read_state.verify_rm_mem = verify_rm_mem;
+    g_glm53_serial_bar1_peer_read_state.length = length;
+    g_glm53_serial_bar1_peer_read_state.gpu_alignment = gpu_alignment;
+    g_glm53_serial_bar1_peer_read_state.seed = seed;
+    params->mapping_id = g_glm53_serial_bar1_peer_read_state.mapping_id;
+
+    owner_gpu = NULL;
+    target_rm_mem = NULL;
+    verify_rm_mem = NULL;
+
+    glm53_serial_bar1_fill_outputs(params);
+
+    if (params->phys_query_status != NV_OK ||
+        params->matched_bar_index != 1 ||
+        !params->matched_bar_full_coverage ||
+        params->cpu_resource_start == 0 ||
+        params->cpu_resource_end < params->cpu_resource_start ||
+        (params->cpu_resource_start % UVM_GLM53_PEER_READ_MIN_PAGE_SIZE) != 0 ||
+        params->active_length != length) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+done:
+    if (status != NV_OK) {
+        if (g_glm53_serial_bar1_peer_read_state.owner_active) {
+            if (g_glm53_serial_bar1_peer_read_state.verify_rm_mem)
+                uvm_rm_mem_free(g_glm53_serial_bar1_peer_read_state.verify_rm_mem);
+            if (g_glm53_serial_bar1_peer_read_state.target_rm_mem)
+                uvm_rm_mem_free(g_glm53_serial_bar1_peer_read_state.target_rm_mem);
+            if (g_glm53_serial_bar1_peer_read_state.owner_gpu)
+                uvm_gpu_release(g_glm53_serial_bar1_peer_read_state.owner_gpu);
+            memset(&g_glm53_serial_bar1_peer_read_state, 0, sizeof(g_glm53_serial_bar1_peer_read_state));
+        }
+        if (verify_rm_mem)
+            uvm_rm_mem_free(verify_rm_mem);
+        if (target_rm_mem)
+            uvm_rm_mem_free(target_rm_mem);
+        if (owner_gpu)
+            uvm_gpu_release(owner_gpu);
+    }
+
+    return status;
+}
+
+static NV_STATUS glm53_serial_bar1_check_owner_epoch_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+                                                           bool fill_target_first)
+{
+    uvm_gpu_t *gpu = g_glm53_serial_bar1_peer_read_state.owner_gpu;
+    uvm_rm_mem_t *target = g_glm53_serial_bar1_peer_read_state.target_rm_mem;
+    uvm_rm_mem_t *verify = g_glm53_serial_bar1_peer_read_state.verify_rm_mem;
+    NvU64 length = g_glm53_serial_bar1_peer_read_state.length;
+    NvU64 seed = g_glm53_serial_bar1_peer_read_state.seed;
+    NvU32 epoch = params->epoch;
+    NvU64 byte_offset;
+    NvU64 word_index;
+    NvU32 byte_shift;
+    volatile NvU32 *verify_words;
+    void __iomem *target_cpu;
+    NV_STATUS status = NV_OK;
+
+    if (!g_glm53_serial_bar1_peer_read_state.owner_active || !gpu || !target || !verify)
+        return NV_ERR_INVALID_STATE;
+
+    if (g_glm53_serial_bar1_peer_read_state.remap_active)
+        return NV_ERR_STATE_IN_USE;
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_serial_bar1_peer_read_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (epoch == 0 ||
+        params->test_word_offset >= length) {
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    if (fill_target_first)
+        glm53_serial_bar1_fill_owner_words(uvm_rm_mem_get_cpu_va(target), length, seed, epoch);
+    glm53_rm_cpumap_phys_fill_words(uvm_rm_mem_get_cpu_va(verify), length, seed, epoch, 0xffU);
+
+    params->ce_forward_status = glm53_rm_cpumap_phys_copy_between_rm_mem(gpu,
+                                                                         verify,
+                                                                         target,
+                                                                         length,
+                                                                         UVM_CHANNEL_TYPE_GPU_TO_CPU,
+                                                                         "GLM53 serialized BAR1 owner CE verify");
+    if (params->ce_forward_status != NV_OK)
+        return params->ce_forward_status;
+
+    mb();
+    glm53_serial_bar1_compare_owner_words(uvm_rm_mem_get_cpu_va(verify),
+                                          length,
+                                          seed,
+                                          epoch,
+                                          &params->owner_forward);
+    if (params->owner_forward.status != NV_OK)
+        status = params->owner_forward.status;
+
+    byte_offset = params->test_word_offset;
+    word_index = byte_offset / sizeof(NvU32);
+    byte_shift = (NvU32)((byte_offset & (sizeof(NvU32) - 1)) * 8);
+    verify_words = (volatile NvU32 *)uvm_rm_mem_get_cpu_va(verify);
+    params->expected_word = glm53_serial_bar1_owner_pattern(seed, epoch, word_index);
+    params->observed_word_after_owner_ce = verify_words[word_index];
+
+    if (params->observed_word_after_owner_ce != params->expected_word && status == NV_OK)
+        status = NV_ERR_INVALID_STATE;
+
+    glm53_serial_bar1_fill_outputs(params);
+
+    target_cpu = (void __iomem *)uvm_rm_mem_get_cpu_va(target);
+    if (target_cpu && params->phys_query_status == NV_OK &&
+        params->test_word_offset < length) {
+        mb();
+        params->owner_cpu_readb_offset = params->test_word_offset;
+        params->owner_cpu_readb_resource = params->cpu_resource_start + params->test_word_offset;
+        params->owner_cpu_readb_expected = (params->expected_word >> byte_shift) & 0xffU;
+        params->owner_cpu_readb_observed =
+            (NvU32)readb((const void __iomem *)((const char __iomem *)target_cpu +
+                                                params->test_word_offset));
+        params->owner_cpu_readb_match =
+            (params->owner_cpu_readb_observed == params->owner_cpu_readb_expected) ? 1 : 0;
+        params->owner_cpu_readb_status =
+            params->owner_cpu_readb_match ? NV_OK : NV_ERR_INVALID_STATE;
+        if (params->owner_cpu_readb_status != NV_OK && status == NV_OK)
+            status = params->owner_cpu_readb_status;
+    }
+    else {
+        params->owner_cpu_readb_status = NV_ERR_INVALID_STATE;
+    }
+
+    return status;
+}
+
+static NV_STATUS glm53_serial_bar1_prepare_owner_epoch_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    return glm53_serial_bar1_check_owner_epoch_locked(params, true);
+}
