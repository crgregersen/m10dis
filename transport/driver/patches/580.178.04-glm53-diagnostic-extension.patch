+static NV_STATUS glm53_copy(uvm_gpu_t *gpu,
+                            uvm_channel_type_t channel_type,
+                            uvm_gpu_address_t dst_addr,
+                            uvm_gpu_address_t src_addr,
+                            size_t size,
+                            const char *description)
+{
+    uvm_push_t push;
+    NV_STATUS status;
+
+    status = uvm_push_begin(gpu->channel_manager, channel_type, &push, "%s", description);
+    if (status != NV_OK)
+        return status;
+
+    gpu->parent->ce_hal->memcopy(&push, dst_addr, src_addr, size);
+
+    return uvm_push_end_and_wait(&push);
+}
+
+static NV_STATUS glm53_read_phys_vidmem_to_stage(uvm_gpu_t *gpu,
+                                                 NvU64 phys_offset,
+                                                 NvU64 length,
+                                                 uvm_mem_t *stage_mem)
+{
+    uvm_gpu_address_t dst_addr;
+    uvm_gpu_address_t src_addr;
+
+    UVM_ASSERT(length <= stage_mem->size);
+
+    dst_addr = uvm_mem_gpu_address_virtual_kernel(stage_mem, gpu);
+    src_addr = uvm_gpu_address_physical(UVM_APERTURE_VID, phys_offset);
+
+    return glm53_copy(gpu,
+                      UVM_CHANNEL_TYPE_GPU_TO_CPU,
+                      dst_addr,
+                      src_addr,
+                      (size_t)length,
+                      "GLM53 read local VIDMEM physical offset");
+}
