+NV_STATUS uvm_api_glm53_read_phys_vidmem(UVM_GLM53_READ_PHYS_VIDMEM_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *gpu = NULL;
+    uvm_mem_t *stage_mem = NULL;
+    NvU64 stage_size;
+    NvU64 copied = 0;
+    NV_STATUS status = NV_OK;
+
+    params->bytes_read = 0;
+    params->fb_size = 0;
+    params->fb_phys_start = 0;
+    params->fb_max_allocatable_address = 0;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    if (params->user_out == 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    if (params->length == 0 || params->length > UVM_GLM53_MAX_PHYS_VIDMEM_READ_BYTES)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (params->user_out + params->length < params->user_out)
+        return NV_ERR_INVALID_ADDRESS;
+
+    gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->gpu_uuid);
+    if (!gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    params->fb_size = gpu->mem_info.size;
+    params->fb_phys_start = gpu->mem_info.phys_start;
+    params->fb_max_allocatable_address = gpu->mem_info.max_allocatable_address;
+
+    if (gpu->mem_info.size == 0) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    if (params->phys_offset >= gpu->mem_info.size ||
+        params->length > gpu->mem_info.size - params->phys_offset) {
+        status = NV_ERR_INVALID_LIMIT;
+        goto done;
+    }
+
+    stage_size = min(params->length, (NvU64)UVM_CHUNK_SIZE_MAX);
+    status = uvm_mem_alloc_sysmem_and_map_cpu_kernel(stage_size, current->mm, &stage_mem);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_map_gpu_kernel(stage_mem, gpu);
+    if (status != NV_OK)
+        goto done;
+
+    while (copied < params->length) {
+        NvU64 chunk = min(params->length - copied, stage_size);
+        NvU64 remaining;
+
+        status = glm53_read_phys_vidmem_to_stage(gpu, params->phys_offset + copied, chunk, stage_mem);
+        if (status != NV_OK)
+            goto done;
+
+        nv_speculation_barrier();
+
+        remaining = copy_to_user((void __user *)(unsigned long)(params->user_out + copied),
+                                 uvm_mem_get_cpu_addr_kernel(stage_mem),
+                                 (size_t)chunk);
+        if (remaining != 0) {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto done;
+        }
+
+        copied += chunk;
+        params->bytes_read = copied;
+    }
+
+done:
+    if (stage_mem)
+        uvm_mem_free(stage_mem);
+
+    if (gpu)
+        uvm_gpu_release(gpu);
+
+    return status;
+}
+
+NV_STATUS uvm_api_glm53_list_va_space_pdbs(UVM_GLM53_LIST_VA_SPACE_PDBS_PARAMS *params, struct file *filp)
+{
+    UVM_GLM53_VA_SPACE_PDB_ENTRY *entries = NULL;
+    uvm_va_space_t *va_space;
+    struct mm_struct *target_mm = current->mm;
+    NvU32 capacity = params->entry_capacity;
+    NvU32 entry_count = 0;
+    NV_STATUS status = NV_OK;
+
+    (void)filp;
+
+    params->entry_count = 0;
+    params->matched_va_spaces = 0;
+    params->total_va_spaces = 0;
+    params->overflow = 0;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    if (!target_mm)
+        return NV_ERR_INVALID_STATE;
+
+    if (params->target_pid != 0 && params->target_pid != task_tgid_nr(current))
+        return NV_ERR_NOT_SUPPORTED;
+
+    if (capacity > UVM_GLM53_MAX_PDB_SNAPSHOT_ENTRIES)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (capacity != 0 && params->entries == 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    if (capacity != 0) {
+        entries = uvm_kvmalloc_zero(sizeof(*entries) * capacity);
+        if (!entries)
+            return NV_ERR_NO_MEMORY;
+    }
+
+    uvm_mutex_lock(&g_uvm_global.va_spaces.lock);
+
+    list_for_each_entry(va_space, &g_uvm_global.va_spaces.list, list_node) {
+        uvm_gpu_va_space_t *gpu_va_space;
+        struct mm_struct *va_space_mm = NULL;
+        bool va_space_matches_current = false;
+
+        ++params->total_va_spaces;
+
+        uvm_va_space_down_read(va_space);
+
+        if (uvm_va_space_mm_enabled(va_space))
+            va_space_mm = va_space->va_space_mm.mm;
+
+        if (va_space_mm == target_mm) {
+            va_space_matches_current = true;
+            ++params->matched_va_spaces;
+        }
+
+        for_each_gpu_va_space(gpu_va_space, va_space) {
+            uvm_page_tree_t *tree = &gpu_va_space->page_tables;
+            uvm_gpu_t *gpu = gpu_va_space->gpu;
+            uvm_gpu_phys_address_t pdb = {0};
+            uvm_gpu_phys_address_t root_phys = {0};
+            uvm_gpu_phys_address_t rm_dma = {0};
+            UVM_GLM53_VA_SPACE_PDB_ENTRY *entry;
+
+            if (entry_count >= capacity) {
+                params->overflow = 1;
+                continue;
+            }
+
+            entry = &entries[entry_count++];
+            uvm_uuid_copy(&entry->gpu_uuid, &gpu->uuid);
+
+            if (tree->root) {
+                pdb = uvm_page_tree_pdb_address(tree);
+                root_phys = tree->root->phys_alloc.addr;
+                rm_dma = tree->pdb_rm_dma_address;
+            }
+
+            entry->va_space_ptr = (NvU64)(uintptr_t)va_space;
+            entry->gpu_va_space_ptr = (NvU64)(uintptr_t)gpu_va_space;
+            entry->mm_ptr = (NvU64)(uintptr_t)va_space_mm;
+            entry->pdb_address = pdb.address;
+            entry->root_phys_address = root_phys.address;
+            entry->pdb_rm_dma_address = rm_dma.address;
+            entry->big_page_size = tree->big_page_size;
+            entry->current_pid = task_tgid_nr(current);
+            entry->target_pid = params->target_pid ? params->target_pid : task_tgid_nr(current);
+            entry->gpu_id_value = uvm_id_value(gpu->id);
+            entry->gpu_index = uvm_id_gpu_index(gpu->id);
+            entry->state = uvm_gpu_va_space_state(gpu_va_space);
+            entry->did_set_page_directory = gpu_va_space->did_set_page_directory ? 1 : 0;
+            entry->pdb_aperture = pdb.aperture;
+            entry->root_phys_aperture = root_phys.aperture;
+            entry->pdb_rm_dma_aperture = rm_dma.aperture;
+            entry->range_count = va_space_matches_current ? 1 : 0;
+        }
+
+        uvm_va_space_up_read(va_space);
+    }
+
+    uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+    params->entry_count = entry_count;
+
+    if (entry_count != 0) {
+        NvU64 bytes = sizeof(*entries) * (NvU64)entry_count;
+        unsigned long remaining;
+
+        nv_speculation_barrier();
+
+        remaining = copy_to_user((void __user *)(unsigned long)params->entries, entries, (size_t)bytes);
+        if (remaining != 0)
+            status = NV_ERR_INVALID_ADDRESS;
+    }
+
+    uvm_kvfree(entries);
+
+    return status;
+}
+
+NV_STATUS uvm_api_glm53_phys_reader_self_test(UVM_GLM53_PHYS_READER_SELF_TEST_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *gpu = NULL;
+    uvm_mem_t *pattern_mem = NULL;
+    uvm_mem_t *stage_mem = NULL;
+    uvm_mem_t *vidmem = NULL;
+    uvm_gpu_phys_address_t vidmem_phys = {0};
+    uvm_gpu_address_t vidmem_va = {0};
+    uvm_gpu_address_t pattern_va = {0};
+    NvU64 length = params->length;
+    NvU64 seed = params->seed;
+    NV_STATUS status = NV_OK;
+    NvU32 pass;
+
+    params->bytes_checked = 0;
+    params->vidmem_phys_offset = 0;
+    params->vidmem_gpu_va = 0;
+    params->fb_size = 0;
+    params->fb_phys_start = 0;
+    params->fb_max_allocatable_address = 0;
+    params->pass_count = 0;
+    params->mismatch_count = 0;
+    params->first_word_pass1 = 0;
+    params->first_word_pass2 = 0;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    if (length == 0)
+        length = UVM_GLM53_SELF_TEST_DEFAULT_BYTES;
+
+    if (length > UVM_GLM53_SELF_TEST_MAX_BYTES || (length % sizeof(NvU32)) != 0)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (seed == 0)
+        seed = UVM_GLM53_SELF_TEST_DEFAULT_SEED;
+
+    gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->gpu_uuid);
+    if (!gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    params->fb_size = gpu->mem_info.size;
+    params->fb_phys_start = gpu->mem_info.phys_start;
+    params->fb_max_allocatable_address = gpu->mem_info.max_allocatable_address;
+
+    if (gpu->mem_info.size == 0) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    status = uvm_mem_alloc_sysmem_and_map_cpu_kernel(length, current->mm, &pattern_mem);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_map_gpu_kernel(pattern_mem, gpu);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_alloc_sysmem_and_map_cpu_kernel(length, current->mm, &stage_mem);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_map_gpu_kernel(stage_mem, gpu);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_alloc_vidmem(length, gpu, &vidmem);
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_mem_map_gpu_kernel(vidmem, gpu);
+    if (status != NV_OK)
+        goto done;
+
+    vidmem_phys = uvm_mem_gpu_physical(vidmem, gpu, 0, length);
+    if (vidmem_phys.aperture != UVM_APERTURE_VID) {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+
+    vidmem_va = uvm_mem_gpu_address_virtual_kernel(vidmem, gpu);
+    pattern_va = uvm_mem_gpu_address_virtual_kernel(pattern_mem, gpu);
+
+    params->vidmem_phys_offset = vidmem_phys.address;
+    params->vidmem_gpu_va = vidmem_va.address;
+
+    for (pass = 1; pass <= 2; ++pass) {
+        NvU32 mismatches;
+
+        glm53_fill_pattern(uvm_mem_get_cpu_addr_kernel(pattern_mem), length, seed, pass);
+
+        status = glm53_copy(gpu,
+                            UVM_CHANNEL_TYPE_CPU_TO_GPU,
+                            vidmem_va,
+                            pattern_va,
+                            (size_t)length,
+                            "GLM53 self-test fill local VIDMEM");
+        if (status != NV_OK)
+            goto done;
+
+        status = glm53_read_phys_vidmem_to_stage(gpu, vidmem_phys.address, length, stage_mem);
+        if (status != NV_OK)
+            goto done;
+
+        mismatches = glm53_count_mismatches(uvm_mem_get_cpu_addr_kernel(stage_mem), length, seed, pass);
+        params->mismatch_count += mismatches;
+        if (mismatches != 0) {
+            status = NV_ERR_INVALID_STATE;
+            goto done;
+        }
+
+        if (pass == 1)
+            params->first_word_pass1 = ((NvU32 *)uvm_mem_get_cpu_addr_kernel(stage_mem))[0];
+        else
+            params->first_word_pass2 = ((NvU32 *)uvm_mem_get_cpu_addr_kernel(stage_mem))[0];
+
+        params->pass_count = pass;
+    }
+
+    params->bytes_checked = length;
+
+done:
+    uvm_mem_free(vidmem);
+    uvm_mem_free(stage_mem);
+    uvm_mem_free(pattern_mem);
+
+    if (gpu)
+        uvm_gpu_release(gpu);
+
+    return status;
+}
+
+#define UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK 0x000000001ffffff0ULL
+#define UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_PEER_MASK 0x00000000e0000000ULL
+#define UVM_GLM53_MAXWELL_PTE_VALID_MASK 0x0000000000000001ULL
+#define UVM_GLM53_MAXWELL_PTE_APERTURE_MASK 0x0000000600000000ULL
+#define UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE 8ULL
+
+typedef struct
+{
+    bool active;
+    NvProcessorUuid gpu_uuid;
+    uvm_gpu_va_space_t *gpu_va_space;
+    NvU64 va_space_ptr;
+    NvU64 gpu_va_space_ptr;
+    NvU64 root_phys_address;
+    NvU64 target_va;
+    NvU64 page_size;
+    NvU64 target_pte_phys;
+    NvU64 original_pte;
+    NvU64 temporary_pte;
+} glm53_local_pte_remap_state_t;
+
+static DEFINE_MUTEX(g_glm53_local_pte_remap_mutex);
+static glm53_local_pte_remap_state_t g_glm53_local_pte_remap_state;
+
+static bool glm53_pte_is_local_vidmem(NvU64 pte)
+{
+    return (pte & UVM_GLM53_MAXWELL_PTE_VALID_MASK) &&
+           ((pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK) == 0) &&
+           ((pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_PEER_MASK) == 0);
+}
+
+static NV_STATUS glm53_validate_local_pte_pair(NvU64 target_pte, NvU64 source_pte)
+{
+    NvU64 non_addr_mask = ~UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK;
+
+    if (!glm53_pte_is_local_vidmem(target_pte) || !glm53_pte_is_local_vidmem(source_pte))
+        return NV_ERR_NOT_SUPPORTED;
+
+    if ((target_pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK) ==
+        (source_pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if ((target_pte & non_addr_mask) != (source_pte & non_addr_mask))
+        return NV_ERR_NOT_SUPPORTED;
+
+    return NV_OK;
+}
+
+static NvU64 glm53_make_remapped_pte(NvU64 target_pte, NvU64 source_pte)
+{
+    return (target_pte & ~UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK) |
+           (source_pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_VID_MASK);
+}
+
+static NV_STATUS glm53_read_phys_vidmem_u64(uvm_gpu_t *gpu, NvU64 phys_offset, NvU64 *out_value)
+{
+    uvm_mem_t *stage_mem = NULL;
+    NV_STATUS status;
+
+    if ((phys_offset % UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE) != 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    if (phys_offset >= gpu->mem_info.size ||
+        UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE > gpu->mem_info.size - phys_offset) {
+        return NV_ERR_INVALID_LIMIT;
+    }
+
+    status = uvm_mem_alloc_sysmem_and_map_cpu_kernel(UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE, current->mm, &stage_mem);
+    if (status != NV_OK)
+        return status;
+
+    status = uvm_mem_map_gpu_kernel(stage_mem, gpu);
+    if (status == NV_OK) {
+        status = glm53_read_phys_vidmem_to_stage(gpu,
+                                                 phys_offset,
+                                                 UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE,
+                                                 stage_mem);
+        if (status == NV_OK) {
+            nv_speculation_barrier();
+            *out_value = *(NvU64 *)uvm_mem_get_cpu_addr_kernel(stage_mem);
+        }
+    }
+
+    uvm_mem_free(stage_mem);
+
+    return status;
+}
+
+static NV_STATUS glm53_find_and_lock_gpu_va_space(const UVM_GLM53_LOCAL_PTE_REMAP_PARAMS *params,
+                                                  uvm_va_space_t **out_va_space,
+                                                  uvm_gpu_va_space_t **out_gpu_va_space,
+                                                  uvm_gpu_t **out_gpu)
+{
+    uvm_va_space_t *va_space;
+    NV_STATUS status = NV_ERR_OBJECT_NOT_FOUND;
+
+    *out_va_space = NULL;
+    *out_gpu_va_space = NULL;
+    *out_gpu = NULL;
+
+    uvm_mutex_lock(&g_uvm_global.va_spaces.lock);
+
+    list_for_each_entry(va_space, &g_uvm_global.va_spaces.list, list_node) {
+        uvm_gpu_va_space_t *gpu_va_space;
+        uvm_gpu_t *gpu;
+        uvm_page_tree_t *tree;
+        uvm_gpu_phys_address_t root_phys;
+
+        if ((NvU64)(uintptr_t)va_space != params->va_space_ptr)
+            continue;
+
+        uvm_va_space_down_read(va_space);
+        uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+        gpu = uvm_va_space_get_gpu_by_uuid_with_gpu_va_space(va_space, &params->gpu_uuid);
+        if (!gpu) {
+            status = NV_ERR_INVALID_DEVICE;
+            goto unlock_va_space;
+        }
+
+        gpu_va_space = uvm_gpu_va_space_get(va_space, gpu);
+        if ((NvU64)(uintptr_t)gpu_va_space != params->gpu_va_space_ptr) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (uvm_gpu_va_space_state(gpu_va_space) != UVM_GPU_VA_SPACE_STATE_ACTIVE) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        if (!gpu_va_space->did_set_page_directory) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        tree = &gpu_va_space->page_tables;
+        if (!tree->root) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        root_phys = tree->root->phys_alloc.addr;
+        if (root_phys.aperture != params->root_phys_aperture ||
+            root_phys.address != params->root_phys_address) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (params->page_size != tree->big_page_size || params->page_size != UVM_PAGE_SIZE_128K) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        if ((params->target_va % params->page_size) != 0 ||
+            (params->target_pte_phys % UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE) != 0) {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto unlock_va_space;
+        }
+
+        if (params->target_pte_phys >= gpu->mem_info.size ||
+            UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE > gpu->mem_info.size - params->target_pte_phys) {
+            status = NV_ERR_INVALID_LIMIT;
+            goto unlock_va_space;
+        }
+
+        *out_va_space = va_space;
+        *out_gpu_va_space = gpu_va_space;
+        *out_gpu = gpu;
+        return NV_OK;
+
+unlock_va_space:
+        uvm_va_space_up_read(va_space);
+        return status;
+    }
+
+    uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+    return status;
+}
+
+static NV_STATUS glm53_write_pte_and_invalidate(uvm_gpu_va_space_t *gpu_va_space,
+                                                NvU64 target_va,
+                                                NvU64 page_size,
+                                                NvU64 target_pte_phys,
+                                                NvU64 new_pte)
+{
+    uvm_page_tree_t *tree = &gpu_va_space->page_tables;
+    uvm_gpu_t *gpu = gpu_va_space->gpu;
+    uvm_push_t push;
+    uvm_pte_batch_t pte_batch;
+    uvm_gpu_phys_address_t pte_addr;
+    NV_STATUS status;
+
+    if (!gpu->channel_manager)
+        return NV_ERR_NOT_SUPPORTED;
+
+    status = uvm_push_begin_acquire(gpu->channel_manager,
+                                    UVM_CHANNEL_TYPE_GPU_INTERNAL,
+                                    &tree->tracker,
+                                    &push,
+                                    "GLM53 local VIDMEM PTE remap at 0x%llx",
+                                    target_va);
+    if (status != NV_OK)
+        return status;
+
+    pte_addr = uvm_gpu_phys_address(UVM_APERTURE_VID, target_pte_phys);
+
+    uvm_pte_batch_begin(&push, &pte_batch);
+    uvm_pte_batch_write_pte(&pte_batch, pte_addr, new_pte, UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE);
+    uvm_pte_batch_end(&pte_batch);
+
+    uvm_tlb_batch_single_invalidate(tree, &push, target_va, page_size, page_size, UVM_MEMBAR_SYS);
+
+    return uvm_push_end_and_wait(&push);
+}
+
+static void glm53_remap_fill_common_outputs(UVM_GLM53_LOCAL_PTE_REMAP_PARAMS *params)
+{
+    params->active = g_glm53_local_pte_remap_state.active ? 1 : 0;
+    params->saved_original_pte = g_glm53_local_pte_remap_state.original_pte;
+    params->temporary_pte = g_glm53_local_pte_remap_state.temporary_pte;
+    params->active_target_pte_phys = g_glm53_local_pte_remap_state.target_pte_phys;
+    params->active_target_va = g_glm53_local_pte_remap_state.target_va;
+    if (g_glm53_local_pte_remap_state.gpu_va_space)
+        params->retained_gpu_va_space_state = uvm_gpu_va_space_state(g_glm53_local_pte_remap_state.gpu_va_space);
+    else
+        params->retained_gpu_va_space_state = 0;
+}
+
+NV_STATUS uvm_api_glm53_local_pte_remap(UVM_GLM53_LOCAL_PTE_REMAP_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *target_va_space = NULL;
+    uvm_gpu_va_space_t *gpu_va_space = NULL;
+    uvm_gpu_t *gpu = NULL;
+    NvU64 current_pte = 0;
+    NvU64 new_pte = 0;
+    NvU64 restored_original_pte = 0;
+    NvU64 restored_temporary_pte = 0;
+    NvU64 restored_target_pte_phys = 0;
+    NvU64 restored_target_va = 0;
+    bool restore_completed = false;
+    NV_STATUS status = NV_OK;
+
+    (void)filp;
+
+    params->pte_before = 0;
+    params->pte_written = 0;
+    params->pte_after = 0;
+    params->rmStatus = NV_OK;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_local_pte_remap_mutex);
+    glm53_remap_fill_common_outputs(params);
+
+    if (params->op == UVM_GLM53_LOCAL_PTE_REMAP_OP_QUERY) {
+        mutex_unlock(&g_glm53_local_pte_remap_mutex);
+        return NV_OK;
+    }
+
+    if (params->op != UVM_GLM53_LOCAL_PTE_REMAP_OP_APPLY &&
+        params->op != UVM_GLM53_LOCAL_PTE_REMAP_OP_RESTORE) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (params->root_phys_aperture != UVM_APERTURE_VID) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_LOCAL_PTE_REMAP_OP_APPLY) {
+        if (g_glm53_local_pte_remap_state.active) {
+            status = NV_ERR_STATE_IN_USE;
+            goto done;
+        }
+    }
+    else {
+        if (!g_glm53_local_pte_remap_state.active) {
+            status = NV_ERR_INVALID_STATE;
+            goto done;
+        }
+
+        if (!uvm_uuid_eq(&g_glm53_local_pte_remap_state.gpu_uuid, &params->gpu_uuid) ||
+            g_glm53_local_pte_remap_state.va_space_ptr != params->va_space_ptr ||
+            g_glm53_local_pte_remap_state.gpu_va_space_ptr != params->gpu_va_space_ptr ||
+            g_glm53_local_pte_remap_state.root_phys_address != params->root_phys_address ||
+            g_glm53_local_pte_remap_state.target_va != params->target_va ||
+            g_glm53_local_pte_remap_state.page_size != params->page_size ||
+            g_glm53_local_pte_remap_state.target_pte_phys != params->target_pte_phys) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto done;
+        }
+    }
+
+    status = glm53_find_and_lock_gpu_va_space(params, &target_va_space, &gpu_va_space, &gpu);
+    if (status != NV_OK)
+        goto done;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &current_pte);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_before = current_pte;
+
+    if (current_pte != params->expected_current_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_LOCAL_PTE_REMAP_OP_APPLY) {
+        status = glm53_validate_local_pte_pair(current_pte, params->replacement_source_pte);
+        if (status != NV_OK)
+            goto unlock_va_space;
+
+        new_pte = glm53_make_remapped_pte(current_pte, params->replacement_source_pte);
+
+        memset(&g_glm53_local_pte_remap_state, 0, sizeof(g_glm53_local_pte_remap_state));
+        g_glm53_local_pte_remap_state.active = true;
+        uvm_uuid_copy(&g_glm53_local_pte_remap_state.gpu_uuid, &params->gpu_uuid);
+        g_glm53_local_pte_remap_state.gpu_va_space = gpu_va_space;
+        uvm_gpu_va_space_retain(gpu_va_space);
+        g_glm53_local_pte_remap_state.va_space_ptr = params->va_space_ptr;
+        g_glm53_local_pte_remap_state.gpu_va_space_ptr = params->gpu_va_space_ptr;
+        g_glm53_local_pte_remap_state.root_phys_address = params->root_phys_address;
+        g_glm53_local_pte_remap_state.target_va = params->target_va;
+        g_glm53_local_pte_remap_state.page_size = params->page_size;
+        g_glm53_local_pte_remap_state.target_pte_phys = params->target_pte_phys;
+        g_glm53_local_pte_remap_state.original_pte = current_pte;
+        g_glm53_local_pte_remap_state.temporary_pte = new_pte;
+    }
+    else {
+        if (current_pte != g_glm53_local_pte_remap_state.temporary_pte) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        new_pte = g_glm53_local_pte_remap_state.original_pte;
+    }
+
+    status = glm53_write_pte_and_invalidate(gpu_va_space,
+                                            params->target_va,
+                                            params->page_size,
+                                            params->target_pte_phys,
+                                            new_pte);
+    if (status != NV_OK) {
+        if (params->op == UVM_GLM53_LOCAL_PTE_REMAP_OP_APPLY) {
+            NvU64 after_failed_apply = 0;
+
+            if (glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &after_failed_apply) == NV_OK) {
+                params->pte_after = after_failed_apply;
+                if (after_failed_apply == current_pte) {
+                    uvm_gpu_va_space_release(g_glm53_local_pte_remap_state.gpu_va_space);
+                    memset(&g_glm53_local_pte_remap_state, 0, sizeof(g_glm53_local_pte_remap_state));
+                }
+            }
+        }
+        goto unlock_va_space;
+    }
+
+    params->pte_written = new_pte;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &params->pte_after);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    if (params->pte_after != new_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_LOCAL_PTE_REMAP_OP_RESTORE) {
+        restored_original_pte = g_glm53_local_pte_remap_state.original_pte;
+        restored_temporary_pte = g_glm53_local_pte_remap_state.temporary_pte;
+        restored_target_pte_phys = g_glm53_local_pte_remap_state.target_pte_phys;
+        restored_target_va = g_glm53_local_pte_remap_state.target_va;
+        uvm_gpu_va_space_release(g_glm53_local_pte_remap_state.gpu_va_space);
+        memset(&g_glm53_local_pte_remap_state, 0, sizeof(g_glm53_local_pte_remap_state));
+        restore_completed = true;
+    }
+
+unlock_va_space:
+    uvm_va_space_up_read(target_va_space);
+
+done:
+    if (restore_completed) {
+        params->active = 0;
+        params->saved_original_pte = restored_original_pte;
+        params->temporary_pte = restored_temporary_pte;
+        params->active_target_pte_phys = restored_target_pte_phys;
+        params->active_target_va = restored_target_va;
+        params->retained_gpu_va_space_state = 0;
+    }
+    else {
+        glm53_remap_fill_common_outputs(params);
+    }
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_local_pte_remap_mutex);
+
+    return status;
+}
+
+#define UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK   0x00000000fffffff0ULL
+#define UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK     0x0000000000000004ULL
+#define UVM_GLM53_MAXWELL_PTE_VOL_MASK           0x0000000100000000ULL
+#define UVM_GLM53_MAXWELL_PTE_KIND_MASK          0x00000ff000000000ULL
+#define UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK  0x4000000000000000ULL
+#define UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK 0x8000000000000000ULL
+#define UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE      UVM_PAGE_SIZE_128K
+#define UVM_GLM53_PEER_READ_MIN_PAGE_SIZE        UVM_PAGE_SIZE_4K
+
+typedef struct
+{
+    bool active;
+    NvU64 route_id;
+    NvU32 route_type;
+    NvProcessorUuid requester_uuid;
+    NvProcessorUuid owner_uuid;
+    NvU64 owner_va;
+    NvU64 length;
+    NvU64 candidate_gpu_sys_address;
+    NvU64 p2p_page_size_bytes;
+    NvU32 p2p_entries;
+    NvU32 p2p_page_size_type;
+    NvU32 p2p_page_table_flags;
+    struct pci_dev *requester_pci_dev;
+    struct nvidia_p2p_page_table *page_table;
+    struct nvidia_p2p_dma_mapping *dma_mapping;
+} glm53_peer_route_state_t;
+
+typedef struct
+{
+    bool active;
+    NvU64 route_id;
+    NvU32 route_type;
+    NvProcessorUuid requester_uuid;
+    NvProcessorUuid owner_uuid;
+    uvm_gpu_va_space_t *gpu_va_space;
+    NvU64 va_space_ptr;
+    NvU64 gpu_va_space_ptr;
+    NvU64 root_phys_address;
+    NvU64 target_va;
+    NvU64 page_size;
+    NvU64 target_pte_phys;
+    NvU64 original_pte;
+    NvU64 temporary_pte;
+    NvU64 destination_gpu_sys_address;
+} glm53_peer_read_remap_state_t;
+
+static DEFINE_MUTEX(g_glm53_peer_route_mutex);
+static DEFINE_MUTEX(g_glm53_peer_read_remap_mutex);
+static glm53_peer_route_state_t g_glm53_peer_route_state;
+static glm53_peer_read_remap_state_t g_glm53_peer_read_remap_state;
+static NvU64 g_glm53_peer_route_next_id = 1;
+
+static NvU64 glm53_p2p_page_size_bytes(NvU32 page_size_type)
+{
+    switch (page_size_type) {
+        case NVIDIA_P2P_PAGE_SIZE_64KB:
+            return UVM_PAGE_SIZE_64K;
+        case NVIDIA_P2P_PAGE_SIZE_128KB:
+            return UVM_PAGE_SIZE_128K;
+        default:
+            return 0;
+    }
+}
+
+static bool glm53_peer_read_remap_is_active(void)
+{
+    bool active;
+
+    mutex_lock(&g_glm53_peer_read_remap_mutex);
+    active = g_glm53_peer_read_remap_state.active;
+    mutex_unlock(&g_glm53_peer_read_remap_mutex);
+
+    return active;
+}
+
+static void glm53_peer_route_clear_output(UVM_GLM53_PEER_ROUTE_PARAMS *params)
+{
+    NvProcessorUuid requester_uuid = params->requester_uuid;
+    NvProcessorUuid owner_uuid = params->owner_uuid;
+    NvU32 op = params->op;
+    NvU32 requested_route_type = params->requested_route_type;
+    NvU64 owner_va = params->owner_va;
+    NvU64 length = params->length;
+    NvU64 route_id = params->route_id;
+
+    memset(params, 0, sizeof(*params));
+    params->requester_uuid = requester_uuid;
+    params->owner_uuid = owner_uuid;
+    params->op = op;
+    params->requested_route_type = requested_route_type;
+    params->owner_va = owner_va;
+    params->length = length;
+    params->route_id = route_id;
+    params->native_status = NV_OK;
+    params->requester_l2_invalidate_status = NV_OK;
+    params->requester_phys_tlb_invalidate_status = NV_OK;
+    params->rmStatus = NV_OK;
+}
+
+static void glm53_peer_route_fill_active_output(UVM_GLM53_PEER_ROUTE_PARAMS *params)
+{
+    if (!g_glm53_peer_route_state.active)
+        return;
+
+    params->active = 1;
+    params->active_route_type = g_glm53_peer_route_state.route_type;
+    params->route_id = g_glm53_peer_route_state.route_id;
+    params->owner_va = g_glm53_peer_route_state.owner_va;
+    params->length = g_glm53_peer_route_state.length;
+    params->candidate_gpu_sys_address = g_glm53_peer_route_state.candidate_gpu_sys_address;
+    params->validated_length = g_glm53_peer_route_state.length;
+    params->p2p_page_size_bytes = g_glm53_peer_route_state.p2p_page_size_bytes;
+    params->p2p_entries = g_glm53_peer_route_state.p2p_entries;
+    params->p2p_page_size_type = g_glm53_peer_route_state.p2p_page_size_type;
+    params->p2p_page_table_flags = g_glm53_peer_route_state.p2p_page_table_flags;
+}
+
+static NV_STATUS glm53_peer_route_release_active_locked(UVM_GLM53_PEER_ROUTE_PARAMS *params)
+{
+    NvS32 dma_unmap_rc = 0;
+    NvS32 put_pages_rc = 0;
+    struct pci_dev *requester_pci_dev = g_glm53_peer_route_state.requester_pci_dev;
+    struct nvidia_p2p_page_table *page_table = g_glm53_peer_route_state.page_table;
+    struct nvidia_p2p_dma_mapping *dma_mapping = g_glm53_peer_route_state.dma_mapping;
+    NvU64 owner_va = g_glm53_peer_route_state.owner_va;
+
+    if (!g_glm53_peer_route_state.active)
+        return NV_ERR_INVALID_STATE;
+
+    if (dma_mapping) {
+        dma_unmap_rc = nvidia_p2p_dma_unmap_pages(requester_pci_dev, page_table, dma_mapping);
+        params->p2p_dma_unmap_rc = dma_unmap_rc;
+    }
+
+    if (page_table) {
+        put_pages_rc = nvidia_p2p_put_pages_persistent(owner_va, page_table, NVIDIA_P2P_FLAGS_DEFAULT);
+        params->p2p_put_pages_rc = put_pages_rc;
+    }
+
+    if (requester_pci_dev)
+        pci_dev_put(requester_pci_dev);
+
+    memset(&g_glm53_peer_route_state, 0, sizeof(g_glm53_peer_route_state));
+
+    if (dma_unmap_rc != 0 || put_pages_rc != 0)
+        return NV_ERR_GENERIC;
+
+    return NV_OK;
+}
+
+static NV_STATUS glm53_peer_route_native_probe(UVM_GLM53_PEER_ROUTE_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *requester_gpu = NULL;
+    uvm_gpu_t *owner_gpu = NULL;
+    NV_STATUS status = NV_OK;
+
+    requester_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->requester_uuid);
+    if (!requester_gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    owner_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->owner_uuid);
+    if (!owner_gpu) {
+        uvm_gpu_release(requester_gpu);
+        return NV_ERR_INVALID_DEVICE;
+    }
+
+    uvm_mutex_lock(&g_uvm_global.global_lock);
+    params->native_status = uvm_gpu_retain_pcie_peer_access(requester_gpu, owner_gpu);
+    if (params->native_status == NV_OK) {
+        uvm_aperture_t peer_aperture = uvm_gpu_peer_aperture(requester_gpu, owner_gpu);
+
+        params->native_retained = 1;
+        params->native_link_type = uvm_parent_gpu_peer_link_type(requester_gpu->parent, owner_gpu->parent);
+        params->native_peer_aperture = peer_aperture;
+        params->native_peer_id = UVM_APERTURE_PEER_ID(peer_aperture);
+        uvm_gpu_release_pcie_peer_access(requester_gpu, owner_gpu);
+    }
+    else {
+        params->native_link_type = uvm_parent_gpu_peer_link_type(requester_gpu->parent, owner_gpu->parent);
+    }
+    uvm_mutex_unlock(&g_uvm_global.global_lock);
+
+    uvm_gpu_release(owner_gpu);
+    uvm_gpu_release(requester_gpu);
+
+    return status;
+}
+
+static NV_STATUS glm53_peer_route_bar1_setup(UVM_GLM53_PEER_ROUTE_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *requester_gpu = NULL;
+    uvm_gpu_t *owner_gpu = NULL;
+    struct pci_dev *requester_pci_dev = NULL;
+    struct nvidia_p2p_page_table *page_table = NULL;
+    struct nvidia_p2p_dma_mapping *dma_mapping = NULL;
+    NvU64 page_size_bytes;
+    NvU64 dma_end;
+    NvU64 gpu_sys_end;
+    NvU32 i;
+    bool dma_contiguous;
+    bool in_window;
+    bool page_table_owned = false;
+    bool dma_mapping_owned = false;
+    NV_STATUS status = NV_OK;
+
+    if (g_glm53_peer_route_state.active)
+        return NV_ERR_STATE_IN_USE;
+
+    if (params->requested_route_type != UVM_GLM53_PEER_ROUTE_TYPE_BAR1_SYS)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (params->length == 0 || params->length != UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (params->owner_va + params->length < params->owner_va)
+        return NV_ERR_INVALID_ADDRESS;
+
+    if ((params->owner_va % UVM_PAGE_SIZE_64K) != 0 || (params->length % UVM_PAGE_SIZE_64K) != 0)
+        return NV_ERR_INVALID_ADDRESS;
+
+    requester_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->requester_uuid);
+    if (!requester_gpu)
+        return NV_ERR_INVALID_DEVICE;
+
+    owner_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->owner_uuid);
+    if (!owner_gpu) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto done;
+    }
+
+    requester_pci_dev = requester_gpu->parent->pci_dev;
+    pci_dev_get(requester_pci_dev);
+
+    params->requester_dma_addressable_start = requester_gpu->parent->dma_addressable_start;
+    params->requester_dma_addressable_limit = requester_gpu->parent->dma_addressable_limit;
+    params->owner_static_bar1_start = owner_gpu->parent->static_bar1_start;
+    params->owner_static_bar1_size = owner_gpu->parent->static_bar1_size;
+
+    params->p2p_get_pages_rc = nvidia_p2p_get_pages_persistent(params->owner_va,
+                                                               params->length,
+                                                               &page_table,
+                                                               NVIDIA_P2P_FLAGS_DEFAULT);
+    if (params->p2p_get_pages_rc != 0) {
+        page_table = NULL;
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    if (!page_table || !page_table->gpu_uuid || !page_table->pages) {
+        page_table = NULL;
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    page_table_owned = true;
+
+    params->p2p_page_size_type = page_table->page_size;
+    params->p2p_entries = page_table->entries;
+    params->p2p_page_table_flags = page_table->flags;
+    page_size_bytes = glm53_p2p_page_size_bytes(page_table->page_size);
+    params->p2p_page_size_bytes = page_size_bytes;
+
+    if (page_table->entries > 0 && page_table->pages && page_table->pages[0])
+        params->p2p_page0_physical = page_table->pages[0]->physical_address;
+
+    if (page_table->entries > 1 && page_table->pages && page_table->pages[1])
+        params->p2p_page1_physical = page_table->pages[1]->physical_address;
+
+    if (page_size_bytes == 0 || page_table->entries == 0) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    params->p2p_dma_map_rc = nvidia_p2p_dma_map_pages(requester_pci_dev, page_table, &dma_mapping);
+    if (params->p2p_dma_map_rc != 0) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    if (!dma_mapping || !dma_mapping->dma_addresses) {
+        dma_mapping = NULL;
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    dma_mapping_owned = true;
+
+    if (dma_mapping->entries > 0 && dma_mapping->dma_addresses)
+        params->p2p_page0_dma = dma_mapping->dma_addresses[0];
+    if (dma_mapping->entries > 1 && dma_mapping->dma_addresses)
+        params->p2p_page1_dma = dma_mapping->dma_addresses[1];
+
+    dma_contiguous = true;
+    for (i = 1; i < dma_mapping->entries; ++i) {
+        if (dma_mapping->dma_addresses[i - 1] + page_size_bytes != dma_mapping->dma_addresses[i]) {
+            dma_contiguous = false;
+            break;
+        }
+    }
+    params->dma_contiguous_for_length = dma_contiguous ? 1 : 0;
+
+    in_window = false;
+    dma_end = params->p2p_page0_dma + params->length - 1;
+    if (dma_mapping->entries >= ((params->length + page_size_bytes - 1) / page_size_bytes) &&
+        page_size_bytes != 0 &&
+        params->p2p_page0_dma >= requester_gpu->parent->dma_addressable_start &&
+        dma_end >= params->p2p_page0_dma &&
+        dma_end <= requester_gpu->parent->dma_addressable_limit) {
+        in_window = true;
+    }
+    params->dma_in_requester_window = in_window ? 1 : 0;
+
+    if (in_window) {
+        params->p2p_page0_gpu_sys = uvm_parent_gpu_dma_addr_to_gpu_addr(requester_gpu->parent, params->p2p_page0_dma);
+        if (dma_mapping->entries > 1 &&
+            params->p2p_page1_dma >= requester_gpu->parent->dma_addressable_start &&
+            params->p2p_page1_dma <= requester_gpu->parent->dma_addressable_limit) {
+            params->p2p_page1_gpu_sys = uvm_parent_gpu_dma_addr_to_gpu_addr(requester_gpu->parent, params->p2p_page1_dma);
+        }
+        params->candidate_gpu_sys_address = params->p2p_page0_gpu_sys;
+        gpu_sys_end = params->candidate_gpu_sys_address + params->length - 1;
+        if ((params->candidate_gpu_sys_address % UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE) == 0 &&
+            gpu_sys_end >= params->candidate_gpu_sys_address) {
+            params->dma_aligned_for_128k_leaf = 1;
+        }
+    }
+
+    if (!dma_contiguous || !in_window || !params->dma_aligned_for_128k_leaf) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    params->validated_length = params->length;
+    memset(&g_glm53_peer_route_state, 0, sizeof(g_glm53_peer_route_state));
+    g_glm53_peer_route_state.active = true;
+    g_glm53_peer_route_state.route_id = g_glm53_peer_route_next_id++;
+    if (g_glm53_peer_route_next_id == 0)
+        g_glm53_peer_route_next_id = 1;
+    g_glm53_peer_route_state.route_type = UVM_GLM53_PEER_ROUTE_TYPE_BAR1_SYS;
+    uvm_uuid_copy(&g_glm53_peer_route_state.requester_uuid, &params->requester_uuid);
+    uvm_uuid_copy(&g_glm53_peer_route_state.owner_uuid, &params->owner_uuid);
+    g_glm53_peer_route_state.owner_va = params->owner_va;
+    g_glm53_peer_route_state.length = params->length;
+    g_glm53_peer_route_state.candidate_gpu_sys_address = params->candidate_gpu_sys_address;
+    g_glm53_peer_route_state.p2p_page_size_bytes = params->p2p_page_size_bytes;
+    g_glm53_peer_route_state.p2p_entries = params->p2p_entries;
+    g_glm53_peer_route_state.p2p_page_size_type = params->p2p_page_size_type;
+    g_glm53_peer_route_state.p2p_page_table_flags = params->p2p_page_table_flags;
+    g_glm53_peer_route_state.requester_pci_dev = requester_pci_dev;
+    g_glm53_peer_route_state.page_table = page_table;
+    g_glm53_peer_route_state.dma_mapping = dma_mapping;
+    requester_pci_dev = NULL;
+    page_table = NULL;
+    dma_mapping = NULL;
+    page_table_owned = false;
+    dma_mapping_owned = false;
+
+    params->route_id = g_glm53_peer_route_state.route_id;
+    params->active = 1;
+    params->active_route_type = UVM_GLM53_PEER_ROUTE_TYPE_BAR1_SYS;
+
+done:
+    if (dma_mapping_owned && dma_mapping)
+        params->p2p_dma_unmap_rc = nvidia_p2p_dma_unmap_pages(requester_pci_dev, page_table, dma_mapping);
+    if (page_table_owned && page_table)
+        params->p2p_put_pages_rc = nvidia_p2p_put_pages_persistent(params->owner_va,
+                                                                   page_table,
+                                                                   NVIDIA_P2P_FLAGS_DEFAULT);
+    if (requester_pci_dev)
+        pci_dev_put(requester_pci_dev);
+    if (owner_gpu)
+        uvm_gpu_release(owner_gpu);
+    if (requester_gpu)
+        uvm_gpu_release(requester_gpu);
+
+    return status;
+}
+
+NV_STATUS uvm_api_glm53_peer_route(UVM_GLM53_PEER_ROUTE_PARAMS *params, struct file *filp)
+{
+    NV_STATUS status = NV_OK;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    glm53_peer_route_clear_output(params);
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_RELEASE && glm53_peer_read_remap_is_active()) {
+        params->rmStatus = NV_ERR_STATE_IN_USE;
+        return NV_ERR_STATE_IN_USE;
+    }
+
+    mutex_lock(&g_glm53_peer_route_mutex);
+    glm53_peer_route_fill_active_output(params);
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_QUERY) {
+        status = NV_OK;
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_NATIVE_PROBE) {
+        status = glm53_peer_route_native_probe(params, filp);
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_BAR1_SETUP) {
+        status = glm53_peer_route_bar1_setup(params, filp);
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_CACHE_SYNC) {
+        uvm_va_space_t *va_space = uvm_va_space_get(filp);
+        uvm_gpu_t *requester_gpu;
+
+        if (!g_glm53_peer_route_state.active || params->route_id != g_glm53_peer_route_state.route_id) {
+            status = NV_ERR_INVALID_STATE;
+            goto done;
+        }
+
+        requester_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &g_glm53_peer_route_state.requester_uuid);
+        if (!requester_gpu) {
+            status = NV_ERR_INVALID_DEVICE;
+            goto done;
+        }
+
+        params->requester_l2_invalidate_status = uvm_mmu_l2_invalidate(requester_gpu, UVM_APERTURE_SYS);
+        params->requester_phys_tlb_invalidate_status = uvm_mmu_tlb_invalidate_phys(requester_gpu);
+        if (params->requester_l2_invalidate_status != NV_OK)
+            status = params->requester_l2_invalidate_status;
+        else if (params->requester_phys_tlb_invalidate_status != NV_OK)
+            status = params->requester_phys_tlb_invalidate_status;
+
+        uvm_gpu_release(requester_gpu);
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_PEER_ROUTE_OP_RELEASE) {
+        status = glm53_peer_route_release_active_locked(params);
+        goto done;
+    }
+
+    status = NV_ERR_INVALID_ARGUMENT;
+
+done:
+    glm53_peer_route_fill_active_output(params);
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_peer_route_mutex);
+
+    return status;
+}
+
+static void glm53_peer_read_remap_fill_outputs(UVM_GLM53_PEER_READ_REMAP_PARAMS *params)
+{
+    if (g_glm53_peer_read_remap_state.active) {
+        params->active = 1;
+        params->route_id = g_glm53_peer_read_remap_state.route_id;
+        params->route_type = g_glm53_peer_read_remap_state.route_type;
+        params->saved_original_pte = g_glm53_peer_read_remap_state.original_pte;
+        params->temporary_pte = g_glm53_peer_read_remap_state.temporary_pte;
+        params->active_target_pte_phys = g_glm53_peer_read_remap_state.target_pte_phys;
+        params->active_target_va = g_glm53_peer_read_remap_state.target_va;
+        params->destination_gpu_sys_address = g_glm53_peer_read_remap_state.destination_gpu_sys_address;
+        if (g_glm53_peer_read_remap_state.gpu_va_space) {
+            params->retained_gpu_va_space_state =
+                uvm_gpu_va_space_state(g_glm53_peer_read_remap_state.gpu_va_space);
+        }
+    }
+}
+
+static void glm53_peer_read_remap_decode_pte_outputs(UVM_GLM53_PEER_READ_REMAP_PARAMS *params, NvU64 pte)
+{
+    params->decoded_aperture_bits = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK) >> 33);
+    params->decoded_kind = (NvU32)((pte & UVM_GLM53_MAXWELL_PTE_KIND_MASK) >> 36);
+    params->decoded_read_only = (pte & UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK) ? 1 : 0;
+    params->decoded_read_disable = (pte & UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK) ? 1 : 0;
+    params->decoded_write_disable = (pte & UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK) ? 1 : 0;
+    params->decoded_volatile = (pte & UVM_GLM53_MAXWELL_PTE_VOL_MASK) ? 1 : 0;
+    params->decoded_sys_address = (pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK) << 8;
+}
+
+static bool glm53_pte_is_read_only_sys(NvU64 pte, NvU64 expected_address)
+{
+    return (pte & UVM_GLM53_MAXWELL_PTE_VALID_MASK) &&
+           ((pte & UVM_GLM53_MAXWELL_PTE_APERTURE_MASK) == (2ULL << 33)) &&
+           ((pte & UVM_GLM53_MAXWELL_PTE_ADDRESS_SYS_MASK) ==
+            ((expected_address >> 12) << 4)) &&
+           (pte & UVM_GLM53_MAXWELL_PTE_READ_ONLY_MASK) &&
+           !(pte & UVM_GLM53_MAXWELL_PTE_READ_DISABLE_MASK) &&
+           (pte & UVM_GLM53_MAXWELL_PTE_WRITE_DISABLE_MASK);
+}
+
+static NV_STATUS glm53_peer_read_remap_find_and_lock_gpu_va_space(
+    const UVM_GLM53_PEER_READ_REMAP_PARAMS *params,
+    uvm_va_space_t **out_va_space,
+    uvm_gpu_va_space_t **out_gpu_va_space,
+    uvm_gpu_t **out_gpu)
+{
+    uvm_va_space_t *va_space;
+    NV_STATUS status = NV_ERR_OBJECT_NOT_FOUND;
+
+    *out_va_space = NULL;
+    *out_gpu_va_space = NULL;
+    *out_gpu = NULL;
+
+    uvm_mutex_lock(&g_uvm_global.va_spaces.lock);
+
+    list_for_each_entry(va_space, &g_uvm_global.va_spaces.list, list_node) {
+        uvm_gpu_va_space_t *gpu_va_space;
+        uvm_gpu_t *gpu;
+        uvm_page_tree_t *tree;
+        uvm_gpu_phys_address_t root_phys;
+
+        if ((NvU64)(uintptr_t)va_space != params->va_space_ptr)
+            continue;
+
+        uvm_va_space_down_read(va_space);
+        uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+        gpu = uvm_va_space_get_gpu_by_uuid_with_gpu_va_space(va_space, &params->requester_uuid);
+        if (!gpu) {
+            status = NV_ERR_INVALID_DEVICE;
+            goto unlock_va_space;
+        }
+
+        gpu_va_space = uvm_gpu_va_space_get(va_space, gpu);
+        if ((NvU64)(uintptr_t)gpu_va_space != params->gpu_va_space_ptr) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (uvm_gpu_va_space_state(gpu_va_space) != UVM_GPU_VA_SPACE_STATE_ACTIVE) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        if (!gpu_va_space->did_set_page_directory) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        tree = &gpu_va_space->page_tables;
+        if (!tree->root) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        root_phys = tree->root->phys_alloc.addr;
+        if (root_phys.aperture != params->root_phys_aperture ||
+            root_phys.address != params->root_phys_address) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto unlock_va_space;
+        }
+
+        if (params->page_size != tree->big_page_size ||
+            params->page_size != UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        if ((params->target_va % params->page_size) != 0 ||
+            (params->target_pte_phys % UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE) != 0) {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto unlock_va_space;
+        }
+
+        if (params->target_pte_phys >= gpu->mem_info.size ||
+            UVM_GLM53_MAXWELL_PTE_ENTRY_SIZE > gpu->mem_info.size - params->target_pte_phys) {
+            status = NV_ERR_INVALID_LIMIT;
+            goto unlock_va_space;
+        }
+
+        *out_va_space = va_space;
+        *out_gpu_va_space = gpu_va_space;
+        *out_gpu = gpu;
+        return NV_OK;
+
+unlock_va_space:
+        uvm_va_space_up_read(va_space);
+        return status;
+    }
+
+    uvm_mutex_unlock(&g_uvm_global.va_spaces.lock);
+
+    return status;
+}
+
+NV_STATUS uvm_api_glm53_peer_read_remap(UVM_GLM53_PEER_READ_REMAP_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *target_va_space = NULL;
+    uvm_gpu_va_space_t *gpu_va_space = NULL;
+    uvm_gpu_t *gpu = NULL;
+    NvU64 current_pte = 0;
+    NvU64 new_pte = 0;
+    NvU64 restored_original_pte = 0;
+    NvU64 restored_temporary_pte = 0;
+    NvU64 restored_target_pte_phys = 0;
+    NvU64 restored_target_va = 0;
+    NvU64 restored_destination = 0;
+    bool restore_completed = false;
+    NV_STATUS status = NV_OK;
+
+    (void)filp;
+
+    params->pte_before = 0;
+    params->pte_written = 0;
+    params->pte_after = 0;
+    params->rmStatus = NV_OK;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_peer_read_remap_mutex);
+    glm53_peer_read_remap_fill_outputs(params);
+
+    if (params->op == UVM_GLM53_PEER_READ_REMAP_OP_QUERY) {
+        mutex_unlock(&g_glm53_peer_read_remap_mutex);
+        return NV_OK;
+    }
+
+    if (params->op != UVM_GLM53_PEER_READ_REMAP_OP_APPLY &&
+        params->op != UVM_GLM53_PEER_READ_REMAP_OP_RESTORE) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (params->root_phys_aperture != UVM_APERTURE_VID ||
+        params->route_type != UVM_GLM53_PEER_ROUTE_TYPE_BAR1_SYS) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    mutex_lock(&g_glm53_peer_route_mutex);
+    if (!g_glm53_peer_route_state.active ||
+        g_glm53_peer_route_state.route_type != UVM_GLM53_PEER_ROUTE_TYPE_BAR1_SYS ||
+        g_glm53_peer_route_state.route_id != params->route_id ||
+        !uvm_uuid_eq(&g_glm53_peer_route_state.requester_uuid, &params->requester_uuid) ||
+        !uvm_uuid_eq(&g_glm53_peer_route_state.owner_uuid, &params->owner_uuid) ||
+        g_glm53_peer_route_state.length < params->page_size) {
+        mutex_unlock(&g_glm53_peer_route_mutex);
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+
+    params->destination_gpu_sys_address = g_glm53_peer_route_state.candidate_gpu_sys_address;
+    mutex_unlock(&g_glm53_peer_route_mutex);
+
+    if ((params->destination_gpu_sys_address % params->page_size) != 0) {
+        status = NV_ERR_INVALID_ADDRESS;
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_PEER_READ_REMAP_OP_APPLY) {
+        if (g_glm53_peer_read_remap_state.active) {
+            status = NV_ERR_STATE_IN_USE;
+            goto done;
+        }
+    }
+    else {
+        if (!g_glm53_peer_read_remap_state.active) {
+            status = NV_ERR_INVALID_STATE;
+            goto done;
+        }
+
+        if (!uvm_uuid_eq(&g_glm53_peer_read_remap_state.requester_uuid, &params->requester_uuid) ||
+            !uvm_uuid_eq(&g_glm53_peer_read_remap_state.owner_uuid, &params->owner_uuid) ||
+            g_glm53_peer_read_remap_state.route_id != params->route_id ||
+            g_glm53_peer_read_remap_state.route_type != params->route_type ||
+            g_glm53_peer_read_remap_state.va_space_ptr != params->va_space_ptr ||
+            g_glm53_peer_read_remap_state.gpu_va_space_ptr != params->gpu_va_space_ptr ||
+            g_glm53_peer_read_remap_state.root_phys_address != params->root_phys_address ||
+            g_glm53_peer_read_remap_state.target_va != params->target_va ||
+            g_glm53_peer_read_remap_state.page_size != params->page_size ||
+            g_glm53_peer_read_remap_state.target_pte_phys != params->target_pte_phys) {
+            status = NV_ERR_OBJECT_TYPE_MISMATCH;
+            goto done;
+        }
+    }
+
+    status = glm53_peer_read_remap_find_and_lock_gpu_va_space(params, &target_va_space, &gpu_va_space, &gpu);
+    if (status != NV_OK)
+        goto done;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &current_pte);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    params->pte_before = current_pte;
+
+    if (current_pte != params->expected_current_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_PEER_READ_REMAP_OP_APPLY) {
+        if (!glm53_pte_is_local_vidmem(current_pte)) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        new_pte = gpu_va_space->page_tables.hal->make_pte(UVM_APERTURE_SYS,
+                                                          params->destination_gpu_sys_address,
+                                                          UVM_PROT_READ_ONLY,
+                                                          UVM_MMU_PTE_FLAGS_NONE);
+        glm53_peer_read_remap_decode_pte_outputs(params, new_pte);
+        if (!glm53_pte_is_read_only_sys(new_pte, params->destination_gpu_sys_address)) {
+            status = NV_ERR_NOT_SUPPORTED;
+            goto unlock_va_space;
+        }
+
+        memset(&g_glm53_peer_read_remap_state, 0, sizeof(g_glm53_peer_read_remap_state));
+        g_glm53_peer_read_remap_state.active = true;
+        g_glm53_peer_read_remap_state.route_id = params->route_id;
+        g_glm53_peer_read_remap_state.route_type = params->route_type;
+        uvm_uuid_copy(&g_glm53_peer_read_remap_state.requester_uuid, &params->requester_uuid);
+        uvm_uuid_copy(&g_glm53_peer_read_remap_state.owner_uuid, &params->owner_uuid);
+        g_glm53_peer_read_remap_state.gpu_va_space = gpu_va_space;
+        uvm_gpu_va_space_retain(gpu_va_space);
+        g_glm53_peer_read_remap_state.va_space_ptr = params->va_space_ptr;
+        g_glm53_peer_read_remap_state.gpu_va_space_ptr = params->gpu_va_space_ptr;
+        g_glm53_peer_read_remap_state.root_phys_address = params->root_phys_address;
+        g_glm53_peer_read_remap_state.target_va = params->target_va;
+        g_glm53_peer_read_remap_state.page_size = params->page_size;
+        g_glm53_peer_read_remap_state.target_pte_phys = params->target_pte_phys;
+        g_glm53_peer_read_remap_state.original_pte = current_pte;
+        g_glm53_peer_read_remap_state.temporary_pte = new_pte;
+        g_glm53_peer_read_remap_state.destination_gpu_sys_address = params->destination_gpu_sys_address;
+    }
+    else {
+        if (current_pte != g_glm53_peer_read_remap_state.temporary_pte) {
+            status = NV_ERR_INVALID_STATE;
+            goto unlock_va_space;
+        }
+
+        new_pte = g_glm53_peer_read_remap_state.original_pte;
+        glm53_peer_read_remap_decode_pte_outputs(params, current_pte);
+    }
+
+    status = glm53_write_pte_and_invalidate(gpu_va_space,
+                                            params->target_va,
+                                            params->page_size,
+                                            params->target_pte_phys,
+                                            new_pte);
+    if (status != NV_OK) {
+        if (params->op == UVM_GLM53_PEER_READ_REMAP_OP_APPLY) {
+            NvU64 after_failed_apply = 0;
+
+            if (glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &after_failed_apply) == NV_OK) {
+                params->pte_after = after_failed_apply;
+                if (after_failed_apply == current_pte) {
+                    uvm_gpu_va_space_release(g_glm53_peer_read_remap_state.gpu_va_space);
+                    memset(&g_glm53_peer_read_remap_state, 0, sizeof(g_glm53_peer_read_remap_state));
+                }
+            }
+        }
+        goto unlock_va_space;
+    }
+
+    params->pte_written = new_pte;
+
+    status = glm53_read_phys_vidmem_u64(gpu, params->target_pte_phys, &params->pte_after);
+    if (status != NV_OK)
+        goto unlock_va_space;
+
+    if (params->pte_after != new_pte) {
+        status = NV_ERR_INVALID_STATE;
+        goto unlock_va_space;
+    }
+
+    if (params->op == UVM_GLM53_PEER_READ_REMAP_OP_RESTORE) {
+        restored_original_pte = g_glm53_peer_read_remap_state.original_pte;
+        restored_temporary_pte = g_glm53_peer_read_remap_state.temporary_pte;
+        restored_target_pte_phys = g_glm53_peer_read_remap_state.target_pte_phys;
+        restored_target_va = g_glm53_peer_read_remap_state.target_va;
+        restored_destination = g_glm53_peer_read_remap_state.destination_gpu_sys_address;
+        uvm_gpu_va_space_release(g_glm53_peer_read_remap_state.gpu_va_space);
+        memset(&g_glm53_peer_read_remap_state, 0, sizeof(g_glm53_peer_read_remap_state));
+        restore_completed = true;
+    }
+
+unlock_va_space:
+    uvm_va_space_up_read(target_va_space);
+
+done:
+    if (restore_completed) {
+        params->active = 0;
+        params->saved_original_pte = restored_original_pte;
+        params->temporary_pte = restored_temporary_pte;
+        params->active_target_pte_phys = restored_target_pte_phys;
+        params->active_target_va = restored_target_va;
+        params->destination_gpu_sys_address = restored_destination;
+        params->retained_gpu_va_space_state = 0;
+    }
+    else {
+        glm53_peer_read_remap_fill_outputs(params);
+    }
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_peer_read_remap_mutex);
+
+    return status;
+}
+
+typedef struct
+{
+    bool active;
+    NvU64 export_id;
+    NvProcessorUuid owner_uuid;
+    NvU64 owner_va;
+    NvU64 length;
+    struct nvidia_p2p_page_table *page_table;
+} glm53_owner_export_state_t;
+
+static DEFINE_MUTEX(g_glm53_owner_export_mutex);
+static glm53_owner_export_state_t g_glm53_owner_export_state;
+static NvU64 g_glm53_owner_export_next_id = 1;
+
+static void glm53_owner_export_clear_output(UVM_GLM53_OWNER_EXPORT_PARAMS *params)
+{
+    NvProcessorUuid owner_uuid = params->owner_uuid;
+    NvU32 op = params->op;
+    NvU32 p2p_flags = params->p2p_flags;
+    NvU64 owner_va = params->owner_va;
+    NvU64 length = params->length;
+    NvU64 export_id = params->export_id;
+
+    memset(params, 0, sizeof(*params));
+    params->owner_uuid = owner_uuid;
+    params->op = op;
+    params->p2p_flags = p2p_flags;
+    params->owner_va = owner_va;
+    params->length = length;
+    params->export_id = export_id;
+    params->rmStatus = NV_OK;
+}
+
+static void glm53_owner_export_fill_page_table(UVM_GLM53_OWNER_EXPORT_PARAMS *params,
+                                               struct nvidia_p2p_page_table *page_table)
+{
+    NvU64 page_size_bytes;
+
+    if (!page_table)
+        return;
+
+    params->page_table_owned = 1;
+    params->p2p_page_table_version = page_table->version;
+    params->p2p_page_size_type = page_table->page_size;
+    params->p2p_entries = page_table->entries;
+    params->p2p_page_table_flags = page_table->flags;
+
+    page_size_bytes = glm53_p2p_page_size_bytes(page_table->page_size);
+    if (page_size_bytes == 0 && page_table->page_size == NVIDIA_P2P_PAGE_SIZE_4KB)
+        page_size_bytes = UVM_PAGE_SIZE_4K;
+    params->p2p_page_size_bytes = page_size_bytes;
+
+    if (page_table->gpu_uuid) {
+        memcpy(params->returned_gpu_uuid, page_table->gpu_uuid, NVIDIA_P2P_GPU_UUID_LEN);
+        params->returned_uuid_matches_owner =
+            memcmp(page_table->gpu_uuid, params->owner_uuid.uuid, NVIDIA_P2P_GPU_UUID_LEN) == 0 ? 1 : 0;
+    }
+
+    if (page_table->entries > 0 && page_table->pages && page_table->pages[0])
+        params->p2p_page0_physical = page_table->pages[0]->physical_address;
+
+    if (page_table->entries > 1 && page_table->pages && page_table->pages[1])
+        params->p2p_page1_physical = page_table->pages[1]->physical_address;
+}
+
+static void glm53_owner_export_fill_active_output(UVM_GLM53_OWNER_EXPORT_PARAMS *params)
+{
+    if (!g_glm53_owner_export_state.active)
+        return;
+
+    params->active = 1;
+    params->page_table_owned = 1;
+    params->export_id = g_glm53_owner_export_state.export_id;
+    params->active_owner_va = g_glm53_owner_export_state.owner_va;
+    params->active_length = g_glm53_owner_export_state.length;
+    glm53_owner_export_fill_page_table(params, g_glm53_owner_export_state.page_table);
+}
+
+static NV_STATUS glm53_owner_export_release_active_locked(UVM_GLM53_OWNER_EXPORT_PARAMS *params)
+{
+    NvS32 put_pages_rc;
+
+    if (!g_glm53_owner_export_state.active || !g_glm53_owner_export_state.page_table)
+        return NV_ERR_INVALID_STATE;
+
+    put_pages_rc = nvidia_p2p_put_pages_persistent(g_glm53_owner_export_state.owner_va,
+                                                   g_glm53_owner_export_state.page_table,
+                                                   NVIDIA_P2P_FLAGS_DEFAULT);
+    params->p2p_put_pages_rc = put_pages_rc;
+
+    memset(&g_glm53_owner_export_state, 0, sizeof(g_glm53_owner_export_state));
+
+    if (put_pages_rc != 0)
+        return NV_ERR_GENERIC;
+
+    return NV_OK;
+}
+
+NV_STATUS uvm_api_glm53_owner_export(UVM_GLM53_OWNER_EXPORT_PARAMS *params, struct file *filp)
+{
+    struct nvidia_p2p_page_table *page_table = NULL;
+    bool page_table_owned = false;
+    NV_STATUS status = NV_OK;
+
+    (void)filp;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_owner_export_mutex);
+    glm53_owner_export_clear_output(params);
+    glm53_owner_export_fill_active_output(params);
+
+    if (params->op == UVM_GLM53_OWNER_EXPORT_OP_QUERY)
+        goto done;
+
+    if (params->op == UVM_GLM53_OWNER_EXPORT_OP_RELEASE) {
+        if (params->export_id != 0 && g_glm53_owner_export_state.active &&
+            params->export_id != g_glm53_owner_export_state.export_id) {
+            status = NV_ERR_INVALID_ARGUMENT;
+            goto done;
+        }
+
+        status = glm53_owner_export_release_active_locked(params);
+        goto done;
+    }
+
+    if (params->op != UVM_GLM53_OWNER_EXPORT_OP_ACQUIRE_PERSISTENT &&
+        params->op != UVM_GLM53_OWNER_EXPORT_OP_FAIL_BEFORE_ACQUIRE_SELF_TEST) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (g_glm53_owner_export_state.active) {
+        status = NV_ERR_STATE_IN_USE;
+        goto done;
+    }
+
+    if (params->length == 0 || params->owner_va + params->length < params->owner_va) {
+        status = NV_ERR_INVALID_LIMIT;
+        goto done;
+    }
+
+    if (params->p2p_flags != NVIDIA_P2P_FLAGS_DEFAULT &&
+        params->p2p_flags != NVIDIA_P2P_FLAGS_FORCE_BAR1_MAPPING) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (params->op == UVM_GLM53_OWNER_EXPORT_OP_FAIL_BEFORE_ACQUIRE_SELF_TEST) {
+        NvU64 bad_va = params->owner_va | 1ULL;
+
+        page_table = NULL;
+        params->p2p_get_pages_rc = nvidia_p2p_get_pages_persistent(bad_va,
+                                                                   params->length,
+                                                                   &page_table,
+                                                                   params->p2p_flags);
+        params->failed_pointer_nonnull = page_table ? 1 : 0;
+        status = (params->p2p_get_pages_rc != 0 && page_table == NULL) ? NV_OK : NV_ERR_INVALID_STATE;
+        goto done;
+    }
+
+    page_table = NULL;
+    params->p2p_get_pages_rc = nvidia_p2p_get_pages_persistent(params->owner_va,
+                                                               params->length,
+                                                               &page_table,
+                                                               params->p2p_flags);
+    if (params->p2p_get_pages_rc != 0) {
+        params->failed_pointer_nonnull = page_table ? 1 : 0;
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    if (!page_table || !page_table->gpu_uuid || !page_table->pages || page_table->entries == 0) {
+        status = NV_ERR_INVALID_STATE;
+        if (page_table && page_table->gpu_uuid)
+            page_table_owned = true;
+        goto cleanup_owned;
+    }
+
+    page_table_owned = true;
+    glm53_owner_export_fill_page_table(params, page_table);
+    if (!params->returned_uuid_matches_owner) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto cleanup_owned;
+    }
+
+    memset(&g_glm53_owner_export_state, 0, sizeof(g_glm53_owner_export_state));
+    g_glm53_owner_export_state.active = true;
+    g_glm53_owner_export_state.export_id = g_glm53_owner_export_next_id++;
+    if (g_glm53_owner_export_next_id == 0)
+        g_glm53_owner_export_next_id = 1;
+    uvm_uuid_copy(&g_glm53_owner_export_state.owner_uuid, &params->owner_uuid);
+    g_glm53_owner_export_state.owner_va = params->owner_va;
+    g_glm53_owner_export_state.length = params->length;
+    g_glm53_owner_export_state.page_table = page_table;
+    page_table = NULL;
+    page_table_owned = false;
+
+    params->active = 1;
+    params->export_id = g_glm53_owner_export_state.export_id;
+    params->active_owner_va = g_glm53_owner_export_state.owner_va;
+    params->active_length = g_glm53_owner_export_state.length;
+
+cleanup_owned:
+    if (page_table_owned && page_table) {
+        params->p2p_put_pages_rc =
+            nvidia_p2p_put_pages_persistent(params->owner_va, page_table, NVIDIA_P2P_FLAGS_DEFAULT);
+        if (params->p2p_put_pages_rc != 0 && status == NV_OK)
+            status = NV_ERR_GENERIC;
+    }
+
+done:
+    if (status == NV_OK)
+        glm53_owner_export_fill_active_output(params);
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_owner_export_mutex);
+
+    return status;
+}
+
+#define UVM_GLM53_RM_CPU_MAP_MAX_BYTES (2ULL * 1024ULL * 1024ULL)
+#define UVM_GLM53_RM_CPU_MAP_VERIFY_WORDS 1024U
+
+typedef struct
+{
+    bool active;
+    NvU64 mapping_id;
+    NvProcessorUuid gpu_uuid;
+    uvm_gpu_t *gpu;
+    uvm_rm_mem_t *rm_mem;
+    NvU64 length;
+    NvU64 seed;
+    NvU32 mem_type;
+} glm53_rm_cpu_map_probe_state_t;
+
+static DEFINE_MUTEX(g_glm53_rm_cpu_map_probe_mutex);
+static glm53_rm_cpu_map_probe_state_t g_glm53_rm_cpu_map_probe_state;
+static NvU64 g_glm53_rm_cpu_map_probe_next_id = 1;
+
+static NvU32 glm53_rm_cpu_map_pattern(NvU64 seed, NvU32 mem_type, NvU32 epoch, NvU32 word_index)
+{
+    NvU64 x = seed ^ (((NvU64)mem_type) << 48) ^ (((NvU64)epoch) << 32) ^ word_index;
+
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+
+    return (NvU32)x ^ (NvU32)(x >> 32);
+}
+
+static NvU32 glm53_rm_cpu_map_words_to_check(NvU64 length)
+{
+    NvU64 words = length / sizeof(NvU32);
+
+    if (words > UVM_GLM53_RM_CPU_MAP_VERIFY_WORDS)
+        words = UVM_GLM53_RM_CPU_MAP_VERIFY_WORDS;
+
+    return (NvU32)words;
+}
+
+static void glm53_rm_cpu_map_fill_common_outputs(UVM_GLM53_RM_CPU_MAP_PROBE_PARAMS *params)
+{
+    params->active = g_glm53_rm_cpu_map_probe_state.active ? 1 : 0;
+    if (!g_glm53_rm_cpu_map_probe_state.active || !g_glm53_rm_cpu_map_probe_state.rm_mem)
+        return;
+
+    params->mapping_id = g_glm53_rm_cpu_map_probe_state.mapping_id;
+    params->active_mem_type = g_glm53_rm_cpu_map_probe_state.mem_type;
+    params->active_length = g_glm53_rm_cpu_map_probe_state.length;
+    params->gpu_va = uvm_rm_mem_get_gpu_uvm_va(g_glm53_rm_cpu_map_probe_state.rm_mem,
+                                               g_glm53_rm_cpu_map_probe_state.gpu);
+    params->cpu_va_kernel = (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(g_glm53_rm_cpu_map_probe_state.rm_mem);
+    params->owner_static_bar1_start = g_glm53_rm_cpu_map_probe_state.gpu->parent->static_bar1_start;
+    params->owner_static_bar1_size = g_glm53_rm_cpu_map_probe_state.gpu->parent->static_bar1_size;
+    params->fb_size = g_glm53_rm_cpu_map_probe_state.gpu->mem_info.size;
+    params->fb_max_allocatable_address = g_glm53_rm_cpu_map_probe_state.gpu->mem_info.max_allocatable_address;
+}
+
+static NV_STATUS glm53_rm_cpu_map_write_and_verify(uvm_rm_mem_t *rm_mem,
+                                                   NvU64 length,
+                                                   NvU64 seed,
+                                                   NvU32 mem_type,
+                                                   NvU32 epoch,
+                                                   NvU32 *mismatch_count,
+                                                   NvU32 *words_checked,
+                                                   NvU32 *first_expected,
+                                                   NvU32 *first_observed)
+{
+    NvU32 i;
+    NvU32 words;
+    NvU32 mismatches = 0;
+    volatile NvU32 *cpu_words;
+
+    if (!uvm_rm_mem_mapped_on_cpu(rm_mem))
+        return NV_ERR_INVALID_STATE;
+
+    words = glm53_rm_cpu_map_words_to_check(length);
+    if (words == 0)
+        return NV_ERR_INVALID_LIMIT;
+
+    cpu_words = (volatile NvU32 *)uvm_rm_mem_get_cpu_va(rm_mem);
+
+    for (i = 0; i < words; ++i)
+        cpu_words[i] = glm53_rm_cpu_map_pattern(seed, mem_type, epoch, i);
+
+    mb();
+
+    for (i = 0; i < words; ++i) {
+        NvU32 expected = glm53_rm_cpu_map_pattern(seed, mem_type, epoch, i);
+        NvU32 observed = cpu_words[i];
+
+        if (i == 0) {
+            *first_expected = expected;
+            *first_observed = observed;
+        }
+
+        if (observed != expected)
+            ++mismatches;
+    }
+
+    *mismatch_count = mismatches;
+    *words_checked = words;
+
+    return mismatches == 0 ? NV_OK : NV_ERR_INVALID_STATE;
+}
+
+static NV_STATUS glm53_rm_cpu_map_release_active_locked(UVM_GLM53_RM_CPU_MAP_PROBE_PARAMS *params)
+{
+    if (!g_glm53_rm_cpu_map_probe_state.active)
+        return NV_ERR_INVALID_STATE;
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_rm_cpu_map_probe_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (g_glm53_rm_cpu_map_probe_state.rm_mem)
+        uvm_rm_mem_free(g_glm53_rm_cpu_map_probe_state.rm_mem);
+
+    if (g_glm53_rm_cpu_map_probe_state.gpu)
+        uvm_gpu_release(g_glm53_rm_cpu_map_probe_state.gpu);
+
+    memset(&g_glm53_rm_cpu_map_probe_state, 0, sizeof(g_glm53_rm_cpu_map_probe_state));
+    params->free_completed = 1;
+    params->release_status = NV_OK;
+
+    return NV_OK;
+}
+
+NV_STATUS uvm_api_glm53_rm_cpu_map_probe(UVM_GLM53_RM_CPU_MAP_PROBE_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *gpu = NULL;
+    uvm_rm_mem_t *rm_mem = NULL;
+    uvm_rm_mem_type_t rm_mem_type;
+    NvProcessorUuid gpu_uuid = params->gpu_uuid;
+    NvU32 op = params->op;
+    NvU32 mem_type = params->mem_type;
+    NvU64 length = params->length;
+    NvU64 gpu_alignment = params->gpu_alignment;
+    NvU64 seed = params->seed;
+    NvU64 mapping_id = params->mapping_id;
+    NvU32 first_epoch_expected = 0;
+    NvU32 first_epoch_observed = 0;
+    NV_STATUS status = NV_OK;
+
+    memset(params, 0, sizeof(*params));
+    params->gpu_uuid = gpu_uuid;
+    params->op = op;
+    params->mem_type = mem_type;
+    params->length = length;
+    params->gpu_alignment = gpu_alignment;
+    params->seed = seed;
+    params->mapping_id = mapping_id;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_rm_cpu_map_probe_mutex);
+    glm53_rm_cpu_map_fill_common_outputs(params);
+
+    if (op == UVM_GLM53_RM_CPU_MAP_PROBE_OP_QUERY) {
+        if (g_glm53_rm_cpu_map_probe_state.active) {
+            status = glm53_rm_cpu_map_write_and_verify(g_glm53_rm_cpu_map_probe_state.rm_mem,
+                                                       g_glm53_rm_cpu_map_probe_state.length,
+                                                       g_glm53_rm_cpu_map_probe_state.seed,
+                                                       g_glm53_rm_cpu_map_probe_state.mem_type,
+                                                       3,
+                                                       &params->mismatch_count,
+                                                       &params->words_checked,
+                                                       &params->first_word_expected,
+                                                       &params->first_word_observed);
+            params->verify_status = status;
+        }
+        goto done;
+    }
+
+    if (op == UVM_GLM53_RM_CPU_MAP_PROBE_OP_RELEASE) {
+        status = glm53_rm_cpu_map_release_active_locked(params);
+        goto done;
+    }
+
+    if (op != UVM_GLM53_RM_CPU_MAP_PROBE_OP_ACQUIRE) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (g_glm53_rm_cpu_map_probe_state.active) {
+        status = NV_ERR_STATE_IN_USE;
+        goto done;
+    }
+
+    if (length == 0 || length > UVM_GLM53_RM_CPU_MAP_MAX_BYTES ||
+        (length % UVM_PAGE_SIZE_4K) != 0) {
+        status = NV_ERR_INVALID_LIMIT;
+        goto done;
+    }
+
+    if (seed == 0)
+        seed = UVM_GLM53_SELF_TEST_DEFAULT_SEED ^ 0x524d4350554d4150ULL;
+    params->seed = seed;
+
+    if (mem_type == UVM_GLM53_RM_CPU_MAP_PROBE_TYPE_GPU)
+        rm_mem_type = UVM_RM_MEM_TYPE_GPU;
+    else if (mem_type == UVM_GLM53_RM_CPU_MAP_PROBE_TYPE_SYS)
+        rm_mem_type = UVM_RM_MEM_TYPE_SYS;
+    else {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &gpu_uuid);
+    if (!gpu) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto done;
+    }
+
+    params->owner_static_bar1_start = gpu->parent->static_bar1_start;
+    params->owner_static_bar1_size = gpu->parent->static_bar1_size;
+    params->fb_size = gpu->mem_info.size;
+    params->fb_max_allocatable_address = gpu->mem_info.max_allocatable_address;
+
+    status = uvm_rm_mem_alloc(gpu, rm_mem_type, length, gpu_alignment, &rm_mem);
+    params->acquire_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_map_cpu(rm_mem);
+    params->map_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = glm53_rm_cpu_map_write_and_verify(rm_mem,
+                                               length,
+                                               seed,
+                                               mem_type,
+                                               1,
+                                               &params->mismatch_count,
+                                               &params->words_checked,
+                                               &params->first_word_expected,
+                                               &params->first_word_observed);
+    if (status != NV_OK) {
+        params->verify_status = status;
+        goto done;
+    }
+    first_epoch_expected = params->first_word_expected;
+    first_epoch_observed = params->first_word_observed;
+
+    status = glm53_rm_cpu_map_write_and_verify(rm_mem,
+                                               length,
+                                               seed,
+                                               mem_type,
+                                               2,
+                                               &params->mismatch_count,
+                                               &params->words_checked,
+                                               &params->second_epoch_word_expected,
+                                               &params->second_epoch_word_observed);
+    params->verify_status = status;
+    params->first_word_expected = first_epoch_expected;
+    params->first_word_observed = first_epoch_observed;
+    if (status != NV_OK)
+        goto done;
+
+    memset(&g_glm53_rm_cpu_map_probe_state, 0, sizeof(g_glm53_rm_cpu_map_probe_state));
+    g_glm53_rm_cpu_map_probe_state.active = true;
+    g_glm53_rm_cpu_map_probe_state.mapping_id = g_glm53_rm_cpu_map_probe_next_id++;
+    if (g_glm53_rm_cpu_map_probe_next_id == 0)
+        g_glm53_rm_cpu_map_probe_next_id = 1;
+    uvm_uuid_copy(&g_glm53_rm_cpu_map_probe_state.gpu_uuid, &gpu_uuid);
+    g_glm53_rm_cpu_map_probe_state.gpu = gpu;
+    g_glm53_rm_cpu_map_probe_state.rm_mem = rm_mem;
+    g_glm53_rm_cpu_map_probe_state.length = length;
+    g_glm53_rm_cpu_map_probe_state.seed = seed;
+    g_glm53_rm_cpu_map_probe_state.mem_type = mem_type;
+
+    params->mapping_id = g_glm53_rm_cpu_map_probe_state.mapping_id;
+    gpu = NULL;
+    rm_mem = NULL;
+
+done:
+    if (status != NV_OK && rm_mem)
+        uvm_rm_mem_free(rm_mem);
+
+    if (status != NV_OK && gpu)
+        uvm_gpu_release(gpu);
+
+    glm53_rm_cpu_map_fill_common_outputs(params);
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_rm_cpu_map_probe_mutex);
+
+    return status;
+}
