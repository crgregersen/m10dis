+NV_STATUS uvm_api_glm53_rm_cpumap_phys_probe(UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params, struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *gpu = NULL;
+    uvm_rm_mem_t *target_rm_mem = NULL;
+    uvm_rm_mem_t *verify_rm_mem = NULL;
+    NvProcessorUuid gpu_uuid = params->gpu_uuid;
+    NvU32 op = params->op;
+    NvU32 verify_epoch = params->verify_epoch;
+    NvU64 length = params->length;
+    NvU64 gpu_alignment = params->gpu_alignment;
+    NvU64 seed = params->seed;
+    NvU64 mapping_id = params->mapping_id;
+    NV_STATUS status = NV_OK;
+
+    memset(params, 0, sizeof(*params));
+    params->gpu_uuid = gpu_uuid;
+    params->op = op;
+    params->verify_epoch = verify_epoch;
+    params->length = length;
+    params->gpu_alignment = gpu_alignment;
+    params->seed = seed;
+    params->mapping_id = mapping_id;
+    params->matched_bar_index = UVM_GLM53_RM_CPUMAP_PHYS_BAR_NONE;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    mutex_lock(&g_glm53_rm_cpumap_phys_probe_mutex);
+
+    if (op == UVM_GLM53_RM_CPUMAP_PHYS_PROBE_OP_QUERY) {
+        glm53_rm_cpumap_phys_fill_active_outputs(params);
+        status = NV_OK;
+        goto done;
+    }
+
+    if (op == UVM_GLM53_RM_CPUMAP_PHYS_PROBE_OP_VERIFY) {
+        status = glm53_rm_cpumap_phys_verify_locked(params);
+        glm53_rm_cpumap_phys_fill_active_outputs(params);
+        goto done;
+    }
+
+    if (op == UVM_GLM53_RM_CPUMAP_PHYS_PROBE_OP_RELEASE) {
+        status = glm53_rm_cpumap_phys_release_active_locked(params);
+        goto done;
+    }
+
+    if (op != UVM_GLM53_RM_CPUMAP_PHYS_PROBE_OP_ACQUIRE) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (g_glm53_rm_cpumap_phys_probe_state.active) {
+        status = NV_ERR_STATE_IN_USE;
+        goto done;
+    }
+
+    if (length == 0 ||
+        length > UVM_GLM53_RM_CPUMAP_PHYS_MAX_BYTES ||
+        (length % UVM_PAGE_SIZE_4K) != 0 ||
+        (length % sizeof(NvU32)) != 0) {
+        status = NV_ERR_INVALID_LIMIT;
+        goto done;
+    }
+
+    if (seed == 0)
+        seed = UVM_GLM53_SELF_TEST_DEFAULT_SEED ^ 0x524d4350554d4150ULL;
+
+    gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &gpu_uuid);
+    if (!gpu) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto done;
+    }
+
+    glm53_rm_cpumap_phys_fill_gpu_outputs(gpu, params);
+
+    status = uvm_rm_mem_alloc(gpu, UVM_RM_MEM_TYPE_GPU, length, gpu_alignment, &target_rm_mem);
+    params->acquire_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_map_cpu(target_rm_mem);
+    params->target_map_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_alloc(gpu, UVM_RM_MEM_TYPE_SYS, length, gpu_alignment, &verify_rm_mem);
+    params->verify_alloc_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    status = uvm_rm_mem_map_cpu(verify_rm_mem);
+    params->verify_map_status = status;
+    if (status != NV_OK)
+        goto done;
+
+    memset(&g_glm53_rm_cpumap_phys_probe_state, 0, sizeof(g_glm53_rm_cpumap_phys_probe_state));
+    g_glm53_rm_cpumap_phys_probe_state.active = true;
+    g_glm53_rm_cpumap_phys_probe_state.mapping_id = g_glm53_rm_cpumap_phys_probe_next_id++;
+    if (g_glm53_rm_cpumap_phys_probe_next_id == 0)
+        g_glm53_rm_cpumap_phys_probe_next_id = 1;
+    uvm_uuid_copy(&g_glm53_rm_cpumap_phys_probe_state.gpu_uuid, &gpu_uuid);
+    g_glm53_rm_cpumap_phys_probe_state.gpu = gpu;
+    g_glm53_rm_cpumap_phys_probe_state.target_rm_mem = target_rm_mem;
+    g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem = verify_rm_mem;
+    g_glm53_rm_cpumap_phys_probe_state.length = length;
+    g_glm53_rm_cpumap_phys_probe_state.gpu_alignment = gpu_alignment;
+    g_glm53_rm_cpumap_phys_probe_state.seed = seed;
+
+    params->mapping_id = g_glm53_rm_cpumap_phys_probe_state.mapping_id;
+    gpu = NULL;
+    target_rm_mem = NULL;
+    verify_rm_mem = NULL;
+
+    glm53_rm_cpumap_phys_fill_active_outputs(params);
+
+done:
+    if (status != NV_OK && verify_rm_mem)
+        uvm_rm_mem_free(verify_rm_mem);
+
+    if (status != NV_OK && target_rm_mem)
+        uvm_rm_mem_free(target_rm_mem);
+
+    if (status != NV_OK && gpu)
+        uvm_gpu_release(gpu);
+
+    params->rmStatus = status;
+    mutex_unlock(&g_glm53_rm_cpumap_phys_probe_mutex);
+
+    return status;
+}
