+#define UVM_GLM53_RM_CPUMAP_PHYS_MAX_BYTES (2ULL * 1024ULL * 1024ULL)
+
+typedef struct
+{
+    bool active;
+    NvU64 mapping_id;
+    NvProcessorUuid gpu_uuid;
+    uvm_gpu_t *gpu;
+    uvm_rm_mem_t *target_rm_mem;
+    uvm_rm_mem_t *verify_rm_mem;
+    NvU64 length;
+    NvU64 gpu_alignment;
+    NvU64 seed;
+} glm53_rm_cpumap_phys_probe_state_t;
+
+static DEFINE_MUTEX(g_glm53_rm_cpumap_phys_probe_mutex);
+static glm53_rm_cpumap_phys_probe_state_t g_glm53_rm_cpumap_phys_probe_state;
+static NvU64 g_glm53_rm_cpumap_phys_probe_next_id = 1;
+
+static NvU32 glm53_rm_cpumap_phys_pattern(NvU64 seed, NvU32 epoch, NvU32 path, NvU64 word_index)
+{
+    NvU64 x = seed ^ 0x5048595352414d31ULL;
+
+    x ^= ((NvU64)epoch << 44);
+    x ^= ((NvU64)path << 36);
+    x ^= word_index;
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+
+    return (NvU32)x ^ (NvU32)(x >> 32) ^ (epoch * 0x9e3779b9U);
+}
+
+static void glm53_rm_cpumap_phys_fill_words(void *ptr, NvU64 length, NvU64 seed, NvU32 epoch, NvU32 path)
+{
+    volatile NvU32 *words = (volatile NvU32 *)ptr;
+    NvU64 i;
+
+    UVM_ASSERT((length % sizeof(*words)) == 0);
+
+    for (i = 0; i < length / sizeof(*words); ++i)
+        words[i] = glm53_rm_cpumap_phys_pattern(seed, epoch, path, i);
+
+    mb();
+}
+
+static void glm53_rm_cpumap_phys_compare_words(void *ptr,
+                                               NvU64 length,
+                                               NvU64 seed,
+                                               NvU32 epoch,
+                                               NvU32 path,
+                                               UVM_GLM53_RM_CPUMAP_PHYS_COMPARE_RESULT *result)
+{
+    volatile NvU32 *words = (volatile NvU32 *)ptr;
+    NvU64 i;
+    NvU32 expected;
+    NvU32 observed;
+    NvU32 word_count;
+
+    memset(result, 0, sizeof(*result));
+
+    if (length == 0 || (length % sizeof(*words)) != 0 || length / sizeof(*words) > 0xffffffffULL) {
+        result->status = NV_ERR_INVALID_LIMIT;
+        return;
+    }
+
+    word_count = (NvU32)(length / sizeof(*words));
+    result->words_checked = word_count;
+    result->first_mismatch_index = 0xffffffffU;
+
+    for (i = 0; i < word_count; ++i) {
+        expected = glm53_rm_cpumap_phys_pattern(seed, epoch, path, i);
+        observed = words[i];
+
+        if (i == 0) {
+            result->first_expected = expected;
+            result->first_observed = observed;
+        }
+
+        if (i == word_count - 1) {
+            result->last_expected = expected;
+            result->last_observed = observed;
+        }
+
+        if (observed != expected) {
+            if (result->mismatches == 0)
+                result->first_mismatch_index = (NvU32)i;
+            ++result->mismatches;
+        }
+    }
+
+    result->status = result->mismatches == 0 ? NV_OK : NV_ERR_INVALID_STATE;
+}
+
+static void glm53_rm_cpumap_phys_fill_gpu_outputs(uvm_gpu_t *gpu,
+                                                  UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params)
+{
+    struct pci_dev *pci_dev;
+
+    if (!gpu || !gpu->parent)
+        return;
+
+    params->owner_static_bar1_start = gpu->parent->static_bar1_start;
+    params->owner_static_bar1_size = gpu->parent->static_bar1_size;
+    params->fb_size = gpu->mem_info.size;
+    params->fb_max_allocatable_address = gpu->mem_info.max_allocatable_address;
+
+    pci_dev = gpu->parent->pci_dev;
+    if (!pci_dev)
+        return;
+
+    params->owner_bar0_start = pci_resource_start(pci_dev, 0);
+    params->owner_bar0_end = pci_resource_end(pci_dev, 0);
+    params->owner_bar1_start = pci_resource_start(pci_dev, 1);
+    params->owner_bar1_end = pci_resource_end(pci_dev, 1);
+    params->owner_bar3_start = pci_resource_start(pci_dev, 3);
+    params->owner_bar3_end = pci_resource_end(pci_dev, 3);
+}
+
+static NV_STATUS glm53_rm_cpumap_phys_kernel_va_to_phys(NvU64 kernel_va,
+                                                        NvU64 *phys_out)
+{
+    unsigned long pfn;
+
+    if (!is_vmalloc_addr((void *)(uintptr_t)kernel_va))
+        return NV_ERR_NOT_SUPPORTED;
+
+    pfn = vmalloc_to_pfn((void *)(uintptr_t)kernel_va);
+    if (pfn == 0)
+        return NV_ERR_OBJECT_NOT_FOUND;
+
+    *phys_out = ((NvU64)pfn << PAGE_SHIFT) + (kernel_va & (UVM_PAGE_SIZE_4K - 1));
+
+    return NV_OK;
+}
+
+static void glm53_rm_cpumap_phys_match_bar(uvm_gpu_t *gpu,
+                                           UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params)
+{
+    NvU64 bar_starts[3] = { params->owner_bar0_start, params->owner_bar1_start, params->owner_bar3_start };
+    NvU64 bar_ends[3] = { params->owner_bar0_end, params->owner_bar1_end, params->owner_bar3_end };
+    NvU32 bar_indices[3] = { 0, 1, 3 };
+    NvU32 i;
+
+    params->matched_bar_index = UVM_GLM53_RM_CPUMAP_PHYS_BAR_NONE;
+    params->matched_bar_full_coverage = 0;
+
+    if (!gpu || params->cpu_resource_end < params->cpu_resource_start)
+        return;
+
+    for (i = 0; i < 3; ++i) {
+        if (bar_starts[i] == 0 || bar_ends[i] < bar_starts[i])
+            continue;
+
+        if (params->cpu_resource_start >= bar_starts[i] && params->cpu_resource_end <= bar_ends[i]) {
+            params->matched_bar_index = bar_indices[i];
+            params->matched_bar_start = bar_starts[i];
+            params->matched_bar_end = bar_ends[i];
+            params->allocation_bar_offset = params->cpu_resource_start - bar_starts[i];
+            params->matched_bar_full_coverage = 1;
+            return;
+        }
+    }
+}
+
+static NV_STATUS glm53_rm_cpumap_phys_resolve_cpu_mapping(UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params,
+                                                          uvm_rm_mem_t *rm_mem,
+                                                          uvm_gpu_t *gpu)
+{
+    NvU64 addr;
+    NvU64 length;
+    NvU64 start_page;
+    NvU64 end_addr;
+    NvU64 page_count;
+    NvU64 page_offset;
+    NvU64 phys;
+    NvU64 prev_page_resource = 0;
+    NvU64 i;
+    NV_STATUS status;
+
+    if (!rm_mem || !gpu || !uvm_rm_mem_mapped_on_cpu(rm_mem))
+        return NV_ERR_INVALID_STATE;
+
+    addr = (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(rm_mem);
+    length = params->active_length;
+    if (length == 0)
+        return NV_ERR_INVALID_LIMIT;
+
+    if (length - 1 > 0xffffffffffffffffULL - addr)
+        return NV_ERR_INVALID_LIMIT;
+
+    page_offset = addr & (UVM_PAGE_SIZE_4K - 1);
+    start_page = addr & ~(NvU64)(UVM_PAGE_SIZE_4K - 1);
+    end_addr = addr + length - 1;
+    page_count = ((end_addr & ~(NvU64)(UVM_PAGE_SIZE_4K - 1)) - start_page) / UVM_PAGE_SIZE_4K + 1;
+
+    if (page_count == 0 || page_count > 0xffffffffULL)
+        return NV_ERR_INVALID_LIMIT;
+
+    params->cpu_va_class = is_vmalloc_addr((void *)(uintptr_t)addr) ?
+                               UVM_GLM53_RM_CPUMAP_PHYS_VA_CLASS_VMALLOC :
+                               UVM_GLM53_RM_CPUMAP_PHYS_VA_CLASS_UNKNOWN;
+    params->cpu_page_offset = page_offset;
+    params->cpu_page_count = (NvU32)page_count;
+    params->cpu_phys_contiguous = 1;
+    params->cpu_phys_segments = 1;
+
+    for (i = 0; i < page_count; ++i) {
+        status = glm53_rm_cpumap_phys_kernel_va_to_phys(start_page + i * UVM_PAGE_SIZE_4K, &phys);
+        if (status != NV_OK)
+            return status;
+
+        if (i == 0) {
+            params->cpu_page0_resource = phys;
+            params->cpu_resource_start = phys + page_offset;
+        }
+        else if (i == 1) {
+            params->cpu_page1_resource = phys;
+        }
+
+        if (i == page_count - 1) {
+            params->cpu_last_page_resource = phys;
+            params->cpu_resource_end = phys + (end_addr & (UVM_PAGE_SIZE_4K - 1));
+        }
+
+        if (i != 0 && phys != prev_page_resource + UVM_PAGE_SIZE_4K) {
+            params->cpu_phys_contiguous = 0;
+            ++params->cpu_phys_segments;
+        }
+
+        prev_page_resource = phys;
+    }
+
+    glm53_rm_cpumap_phys_match_bar(gpu, params);
+
+    return NV_OK;
+}
+
+static void glm53_rm_cpumap_phys_fill_active_outputs(UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params)
+{
+    if (!g_glm53_rm_cpumap_phys_probe_state.active ||
+        !g_glm53_rm_cpumap_phys_probe_state.gpu ||
+        !g_glm53_rm_cpumap_phys_probe_state.target_rm_mem)
+        return;
+
+    params->active = 1;
+    params->mapping_id = g_glm53_rm_cpumap_phys_probe_state.mapping_id;
+    params->active_length = g_glm53_rm_cpumap_phys_probe_state.length;
+    params->length = g_glm53_rm_cpumap_phys_probe_state.length;
+    params->gpu_alignment = g_glm53_rm_cpumap_phys_probe_state.gpu_alignment;
+    params->seed = g_glm53_rm_cpumap_phys_probe_state.seed;
+    params->target_gpu_va = uvm_rm_mem_get_gpu_uvm_va(g_glm53_rm_cpumap_phys_probe_state.target_rm_mem,
+                                                      g_glm53_rm_cpumap_phys_probe_state.gpu);
+    params->target_cpu_va_kernel =
+        (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(g_glm53_rm_cpumap_phys_probe_state.target_rm_mem);
+
+    if (g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem) {
+        params->verify_gpu_va = uvm_rm_mem_get_gpu_uvm_va(g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem,
+                                                          g_glm53_rm_cpumap_phys_probe_state.gpu);
+        params->verify_cpu_va_kernel =
+            (NvU64)(uintptr_t)uvm_rm_mem_get_cpu_va(g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem);
+    }
+
+    glm53_rm_cpumap_phys_fill_gpu_outputs(g_glm53_rm_cpumap_phys_probe_state.gpu, params);
+
+    params->phys_query_status =
+        glm53_rm_cpumap_phys_resolve_cpu_mapping(params,
+                                                 g_glm53_rm_cpumap_phys_probe_state.target_rm_mem,
+                                                 g_glm53_rm_cpumap_phys_probe_state.gpu);
+}
+
+static NV_STATUS glm53_rm_cpumap_phys_copy_between_rm_mem(uvm_gpu_t *gpu,
+                                                          uvm_rm_mem_t *dst,
+                                                          uvm_rm_mem_t *src,
+                                                          NvU64 length,
+                                                          uvm_channel_type_t channel_type,
+                                                          const char *description)
+{
+    uvm_push_t push;
+    uvm_gpu_address_t dst_addr;
+    uvm_gpu_address_t src_addr;
+    bool is_proxy;
+    NV_STATUS status;
+
+    status = uvm_push_begin(gpu->channel_manager, channel_type, &push, "%s", description);
+    if (status != NV_OK)
+        return status;
+
+    is_proxy = uvm_channel_is_proxy(push.channel);
+    dst_addr = uvm_rm_mem_get_gpu_va(dst, gpu, is_proxy);
+    src_addr = uvm_rm_mem_get_gpu_va(src, gpu, is_proxy);
+    gpu->parent->ce_hal->memcopy(&push, dst_addr, src_addr, length);
+
+    return uvm_push_end_and_wait(&push);
+}
+
+static NV_STATUS glm53_rm_cpumap_phys_verify_locked(UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params)
+{
+    uvm_gpu_t *gpu = g_glm53_rm_cpumap_phys_probe_state.gpu;
+    uvm_rm_mem_t *target = g_glm53_rm_cpumap_phys_probe_state.target_rm_mem;
+    uvm_rm_mem_t *verify = g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem;
+    NvU64 length = g_glm53_rm_cpumap_phys_probe_state.length;
+    NvU64 seed = g_glm53_rm_cpumap_phys_probe_state.seed;
+    NvU32 epoch = params->verify_epoch;
+    NV_STATUS status = NV_OK;
+
+    if (!g_glm53_rm_cpumap_phys_probe_state.active || !gpu || !target || !verify)
+        return NV_ERR_INVALID_STATE;
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_rm_cpumap_phys_probe_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (epoch == 0)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    glm53_rm_cpumap_phys_fill_words(uvm_rm_mem_get_cpu_va(target), length, seed, epoch, 1);
+    glm53_rm_cpumap_phys_fill_words(uvm_rm_mem_get_cpu_va(verify), length, seed, epoch, 0xffU);
+
+    params->ce_forward_status = glm53_rm_cpumap_phys_copy_between_rm_mem(gpu,
+                                                                         verify,
+                                                                         target,
+                                                                         length,
+                                                                         UVM_CHANNEL_TYPE_GPU_TO_CPU,
+                                                                         "GLM53 RM CPU-map phys forward owner CE");
+    if (params->ce_forward_status != NV_OK) {
+        status = params->ce_forward_status;
+        goto reverse;
+    }
+
+    mb();
+    glm53_rm_cpumap_phys_compare_words(uvm_rm_mem_get_cpu_va(verify),
+                                       length,
+                                       seed,
+                                       epoch,
+                                       1,
+                                       &params->forward);
+    if (params->forward.status != NV_OK)
+        status = params->forward.status;
+
+reverse:
+    glm53_rm_cpumap_phys_fill_words(uvm_rm_mem_get_cpu_va(verify), length, seed, epoch, 2);
+
+    params->ce_reverse_status = glm53_rm_cpumap_phys_copy_between_rm_mem(gpu,
+                                                                         target,
+                                                                         verify,
+                                                                         length,
+                                                                         UVM_CHANNEL_TYPE_CPU_TO_GPU,
+                                                                         "GLM53 RM CPU-map phys reverse owner CE");
+    if (params->ce_reverse_status != NV_OK) {
+        if (status == NV_OK)
+            status = params->ce_reverse_status;
+        return status;
+    }
+
+    mb();
+    glm53_rm_cpumap_phys_compare_words(uvm_rm_mem_get_cpu_va(target),
+                                       length,
+                                       seed,
+                                       epoch,
+                                       2,
+                                       &params->reverse);
+    if (status == NV_OK && params->reverse.status != NV_OK)
+        status = params->reverse.status;
+
+    return status;
+}
+
+static NV_STATUS glm53_rm_cpumap_phys_release_active_locked(UVM_GLM53_RM_CPUMAP_PHYS_PROBE_PARAMS *params)
+{
+    if (!g_glm53_rm_cpumap_phys_probe_state.active)
+        return NV_ERR_INVALID_STATE;
+
+    if (params->mapping_id != 0 &&
+        params->mapping_id != g_glm53_rm_cpumap_phys_probe_state.mapping_id)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    if (g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem)
+        uvm_rm_mem_free(g_glm53_rm_cpumap_phys_probe_state.verify_rm_mem);
+
+    if (g_glm53_rm_cpumap_phys_probe_state.target_rm_mem)
+        uvm_rm_mem_free(g_glm53_rm_cpumap_phys_probe_state.target_rm_mem);
+
+    if (g_glm53_rm_cpumap_phys_probe_state.gpu)
+        uvm_gpu_release(g_glm53_rm_cpumap_phys_probe_state.gpu);
+
+    memset(&g_glm53_rm_cpumap_phys_probe_state, 0, sizeof(g_glm53_rm_cpumap_phys_probe_state));
+    params->free_completed = 1;
+    params->release_status = NV_OK;
+
+    return NV_OK;
+}
