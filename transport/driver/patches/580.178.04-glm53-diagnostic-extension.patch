+static NV_STATUS glm53_serial_bar1_verify_owner_epoch_locked(UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params)
+{
+    return glm53_serial_bar1_check_owner_epoch_locked(params, false);
+}
