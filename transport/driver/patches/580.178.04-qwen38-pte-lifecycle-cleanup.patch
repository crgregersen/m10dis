+// Called only after destroy_gpu_va_space() has removed all page tables and
+// destroyed the RM address space. Entries held by this diagnostic otherwise
+// retain the dead object and consume a global slot indefinitely.
+void uvm_glm53_multi_pte_remap_gpu_va_space_destroyed(uvm_gpu_va_space_t *gpu_va_space)
+{
+    NvU32 i;
+    NvU32 released = 0;
+
+    UVM_ASSERT(gpu_va_space);
+    UVM_ASSERT(uvm_gpu_va_space_state(gpu_va_space) == UVM_GPU_VA_SPACE_STATE_DEAD ||
+               uvm_gpu_va_space_state(gpu_va_space) == UVM_GPU_VA_SPACE_STATE_INIT);
+
+    mutex_lock(&g_glm53_multi_pte_remap_mutex);
+    for (i = 0; i < UVM_GLM53_MULTI_PTE_REMAP_MAX_ACTIVE; ++i) {
+        glm53_multi_pte_remap_state_t *entry = &g_glm53_multi_pte_remap_state[i];
+        if (!entry->active || entry->gpu_va_space != gpu_va_space)
+            continue;
+
+        // An INIT VA space was never eligible for APPLY.
+        UVM_ASSERT(uvm_gpu_va_space_state(gpu_va_space) == UVM_GPU_VA_SPACE_STATE_DEAD);
+        memset(entry, 0, sizeof(*entry));
+        ++released;
+        uvm_gpu_va_space_release(gpu_va_space);
+    }
+    mutex_unlock(&g_glm53_multi_pte_remap_mutex);
+
+    if (released)
+        pr_info("nvidia-uvm: GLM53 PTE lifecycle cleanup released %u dead VA-space records\n", released);
+}
