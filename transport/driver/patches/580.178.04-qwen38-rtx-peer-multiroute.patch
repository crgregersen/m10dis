+    g_glm53_serial_bar1_peer_read_state.external_owner = true;
+    g_glm53_serial_bar1_peer_read_state.mapping_id =
+        g_glm53_serial_bar1_peer_read_next_mapping_id++;
+    if (g_glm53_serial_bar1_peer_read_next_mapping_id == 0)
+        g_glm53_serial_bar1_peer_read_next_mapping_id = 1;
+    uvm_uuid_copy(&g_glm53_serial_bar1_peer_read_state.owner_uuid, &params->owner_uuid);
+    uvm_uuid_copy(&g_glm53_serial_bar1_peer_read_state.requester_uuid, &params->requester_uuid);
+    g_glm53_serial_bar1_peer_read_state.owner_gpu = owner_gpu;
+    g_glm53_serial_bar1_peer_read_state.length = length;
+    g_glm53_serial_bar1_peer_read_state.gpu_alignment = UVM_PAGE_SIZE_4K;
