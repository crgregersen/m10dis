+    pci_dev = owner_gpu->parent->pci_dev;
+    cpu_base = pci_resource_start(pci_dev, 1);
+    bus_base = pci_bus_address(pci_dev, 1);
+    bar_len = pci_resource_len(pci_dev, 1);
+    if (cpu_base == 0 || bus_base == 0 || bar_len == 0 || requested_bus < bus_base) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    bar_offset = requested_bus - bus_base;
+    if (bar_offset > bar_len || length > bar_len - bar_offset ||
+        cpu_base > U64_MAX - bar_offset ||
+        (requested_cpu != 0 && requested_cpu != cpu_base + bar_offset) ||
+        length - 1 > U64_MAX - (cpu_base + bar_offset) ||
+        cpu_base + bar_offset + length - 1 > pci_resource_end(pci_dev, 1)) {
+        status = NV_ERR_INVALID_ADDRESS;
+        goto done;
+    }
