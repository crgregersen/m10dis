+// Retain the owner GPU while userspace holds an RM-reflected mapping of an
+// existing CUDA VMM allocation. Validate the CPU resource and bus-address
+// interval as the same BAR1 offset; userspace remains responsible for keeping
+// the CUDA allocation and RM mapping alive until RELEASE_OWNER.
+static NV_STATUS glm53_serial_bar1_acquire_external_owner_locked(
+    UVM_GLM53_SERIAL_BAR1_PEER_READ_PARAMS *params,
+    struct file *filp)
+{
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *owner_gpu = NULL;
+    struct pci_dev *pci_dev;
+    NvU64 length = params->requested_resource_length;
+    NvU64 requested_cpu = params->requested_cpu_resource_start;
+    NvU64 requested_bus = params->requested_owner_bar1_bus_start;
+    NvU64 cpu_base, bus_base, bar_len, bar_offset;
+    NV_STATUS status = NV_OK;
+
+    if (g_glm53_serial_bar1_peer_read_state.owner_active)
+        return NV_ERR_STATE_IN_USE;
+    if (length < UVM_PAGE_SIZE_64K || length > UVM_GLM53_PEER_READ_REMAP_PAGE_SIZE ||
+        (length % UVM_PAGE_SIZE_4K) != 0 || (requested_cpu % UVM_PAGE_SIZE_4K) != 0 ||
+        (requested_bus % UVM_PAGE_SIZE_4K) != 0)
+        return NV_ERR_INVALID_LIMIT;
+
+    owner_gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &params->owner_uuid);
+    if (!owner_gpu || !owner_gpu->parent || !owner_gpu->parent->pci_dev) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto done;
+    }
