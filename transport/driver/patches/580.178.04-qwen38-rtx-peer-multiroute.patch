+    g_glm53_serial_bar1_peer_read_state.external_owner_bus_start = requested_bus;
+    g_glm53_serial_bar1_peer_read_state.external_owner_bar_offset = bar_offset;
+    params->mapping_id = g_glm53_serial_bar1_peer_read_state.mapping_id;
+    owner_gpu = NULL;
+    glm53_serial_bar1_fill_outputs(params);
+
+done:
+    if (owner_gpu)
