+NV_STATUS uvm_api_glm53_local_cache_sync(UVM_GLM53_LOCAL_CACHE_SYNC_PARAMS *params, struct file *filp)
+{
+    NvProcessorUuid gpu_uuid = params->gpu_uuid;
+    NvU32 op = params->op;
+    NvU32 aperture = params->aperture;
+    NvU32 do_phys_tlb_invalidate = params->do_phys_tlb_invalidate;
+    uvm_va_space_t *va_space = uvm_va_space_get(filp);
+    uvm_gpu_t *gpu = NULL;
+    uvm_aperture_t uvm_aperture;
+    NV_STATUS status = NV_OK;
+
+    memset(params, 0, sizeof(*params));
+    params->gpu_uuid = gpu_uuid;
+    params->op = op;
+    params->aperture = aperture;
+    params->do_phys_tlb_invalidate = do_phys_tlb_invalidate;
+    params->l2_invalidate_status = NV_OK;
+    params->phys_tlb_invalidate_status = NV_OK;
+
+    if (!capable(CAP_SYS_RAWIO))
+        return NV_ERR_INSUFFICIENT_PERMISSIONS;
+
+    if (op != UVM_GLM53_LOCAL_CACHE_SYNC_OP_SYNC) {
+        status = NV_ERR_INVALID_ARGUMENT;
+        goto done;
+    }
+
+    if (aperture == UVM_GLM53_LOCAL_CACHE_SYNC_APERTURE_VID)
+        uvm_aperture = UVM_APERTURE_VID;
+    else if (aperture == UVM_GLM53_LOCAL_CACHE_SYNC_APERTURE_SYS)
+        uvm_aperture = UVM_APERTURE_SYS;
+    else {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto done;
+    }
+
+    gpu = uvm_va_space_retain_gpu_by_uuid(va_space, &gpu_uuid);
+    if (!gpu) {
+        status = NV_ERR_INVALID_DEVICE;
+        goto done;
+    }
+    params->retained_gpu = 1;
+
+    params->l2_invalidate_status = uvm_mmu_l2_invalidate(gpu, uvm_aperture);
+    if (params->l2_invalidate_status != NV_OK) {
+        status = params->l2_invalidate_status;
+        goto done;
+    }
+
+    if (do_phys_tlb_invalidate) {
+        params->phys_tlb_invalidate_status = uvm_mmu_tlb_invalidate_phys(gpu);
+        if (params->phys_tlb_invalidate_status != NV_OK)
+            status = params->phys_tlb_invalidate_status;
+    }
+
+done:
+    if (gpu)
+        uvm_gpu_release(gpu);
+    params->rmStatus = status;
+    return status;
